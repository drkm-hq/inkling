@@ -530,6 +530,19 @@ class RotatingKVCache(_BaseCache):
         else:
             return self.keys, self.values
 
+    def key_distances(self):
+        """How many positions behind the most recent key each cached key is, in
+        the order ``update_and_fetch`` returned them (the cache may be rotated)."""
+        S = min(self.offset, self.keys.shape[2])
+        s = mx.arange(S)
+        if self.keys.shape[2] > self.max_size:
+            # Temporal order, right after a multi-token update
+            return S - 1 - s
+        dist = (self._idx - 1 - s) % (self.max_size - self.keep)
+        if self.keep > 0:
+            dist = mx.where(s < self.keep, self.offset - 1 - s, dist)
+        return dist
+
     def size(self):
         return min(self.offset, self.max_size)
 
