+@dataclass
+class TextArgs(BaseModelArgs):
+    model_type: str = "inkling_text"
+    hidden_size: int = 4096
+    num_hidden_layers: int = 42
+    vocab_size: int = 201024
+    unpadded_vocab_size: Optional[int] = None
+    rms_norm_eps: float = 1e-6
+    use_embed_norm: bool = True
+    logits_mup_width_multiplier: float = 1.0
+    num_attention_heads: int = 32
+    num_key_value_heads: int = 8
+    head_dim: int = 128
+    swa_num_attention_heads: Optional[int] = None
+    swa_num_key_value_heads: Optional[int] = None
+    swa_head_dim: Optional[int] = None
+    sliding_window_size: int = 512
+    local_layer_ids: Optional[List[int]] = None
+    layer_types: Optional[List[str]] = None
+    d_rel: int = 16
+    rel_extent: int = 1024
+    log_scaling_n_floor: Optional[int] = None
+    log_scaling_alpha: float = 0.1
+    sconv_kernel_size: int = 4
+    dense_mlp_idx: int = 0
+    mlp_layer_types: Optional[List[str]] = None
+    # ``intermediate_size`` is the width of one expert, the dense layers use
+    # ``dense_intermediate_size``.
+    intermediate_size: int = 2048
+    dense_intermediate_size: Optional[int] = None
+    n_routed_experts: int = 256
+    num_experts_per_tok: int = 6
+    n_shared_experts: int = 2
+    route_scale: float = 8.0
+    use_sconv: bool = True
+    q_bias: bool = False
+    o_bias: bool = False
+    use_gate_bias: bool = True
+    gate_activation: str = "sigmoid"
+    norm_after_topk: bool = True
+    use_global_scale: bool = True
+    shared_expert_sink: bool = True
+    final_logit_softcapping: Optional[float] = None
+
+    def __post_init__(self):
+        if self.swa_num_attention_heads is None:
+            self.swa_num_attention_heads = self.num_attention_heads
+        if self.swa_num_key_value_heads is None:
+            self.swa_num_key_value_heads = self.num_key_value_heads
+        if self.swa_head_dim is None:
+            self.swa_head_dim = self.head_dim
+        if self.dense_intermediate_size is None:
+            self.dense_intermediate_size = self.intermediate_size
+        unsupported = {
+            "use_sconv": self.use_sconv is not True,
+            "q_bias": self.q_bias,
+            "o_bias": self.o_bias,
+            "use_gate_bias": self.use_gate_bias is not True,
+            "gate_activation": self.gate_activation != "sigmoid",
+            "norm_after_topk": self.norm_after_topk is not True,
+            "use_global_scale": self.use_global_scale is not True,
+            "shared_expert_sink": self.shared_expert_sink is not True,
+            "final_logit_softcapping": self.final_logit_softcapping is not None,
+        }
+        bad = [k for k, v in unsupported.items() if v]
+        if bad:
+            raise ValueError(f"Unsupported Inkling configuration: {bad}")
+
+    def layer_is_sliding(self, i: int) -> bool:
+        if self.layer_types is not None:
+            return self.layer_types[i] == "hybrid_sliding"
+        if self.local_layer_ids is not None:
+            return i in self.local_layer_ids
+        return (i + 1) % 6 != 0
+
+    def layer_is_dense(self, i: int) -> bool:
+        if self.mlp_layer_types is not None:
+            return self.mlp_layer_types[i] == "dense"
+        return i < self.dense_mlp_idx
+
