+@partial(mx.compile, shapeless=True)
+def _short_conv_taps(x, *taps_and_weights):
+    # fp32 accumulation, one rounding to the activation dtype (the reference
+    # keeps the whole convolution in fp32)
+    K = len(taps_and_weights) // 2
+    y = x.astype(mx.float32)
+    for t, w in zip(taps_and_weights[:K], taps_and_weights[K:]):
+        y = y + t.astype(mx.float32) * w.astype(mx.float32)
+    return y.astype(x.dtype)
+
+
+@partial(mx.compile, shapeless=True)
+def _short_conv_taps_residual(x, residual, *taps_and_weights):
+    K = len(taps_and_weights) // 2
+    y = x.astype(mx.float32)
+    for t, w in zip(taps_and_weights[:K], taps_and_weights[K:]):
+        y = y + t.astype(mx.float32) * w.astype(mx.float32)
+    # The convolution output is rounded before the layer's residual add
+    y = y.astype(x.dtype).astype(mx.float32) + residual.astype(mx.float32)
+    return y.astype(x.dtype)
+
+
+_SHORT_CONV_SRC = """
+    uint c = thread_position_in_grid.x;   // channel
+    uint b = thread_position_in_grid.y;   // batch row
+    uint C = threads_per_grid.x;
+    uint L = x_shape[1];
+    // The virtual input is [state (K - 1 rows); x (L rows)]
+    for (uint i = 0; i < L; ++i) {
+        float acc = x[b * x_strides[0] + i * x_strides[1] + c * x_strides[2]];
+        for (uint k = 0; k < K; ++k) {
+            int r = int(i + k) - int(K - 1);
+            float v = r < 0
+                ? float(state[b * state_strides[0] + uint(r + K - 1) * state_strides[1]
+                              + c * state_strides[2]])
+                : float(x[b * x_strides[0] + uint(r) * x_strides[1] + c * x_strides[2]]);
+            acc += v * float(w[c * K + k]);
+        }
+        T y = T(acc);
+        if (HAS_RESIDUAL) {
+            y = T(float(y) + float(res[b * res_strides[0] + i * res_strides[1]
+                                       + c * res_strides[2]]));
+        }
+        out[(b * L + i) * C + c] = y;
+    }
+    for (uint k = 0; k < K - 1; ++k) {
+        int r = int(L + k) - int(K - 1);
+        new_state[(b * (K - 1) + k) * C + c] = r < 0
+            ? state[b * state_strides[0] + uint(r + K - 1) * state_strides[1]
+                    + c * state_strides[2]]
+            : x[b * x_strides[0] + uint(r) * x_strides[1] + c * x_strides[2]];
+    }
+"""
+
+
+def _make_short_conv_kernel():
+    if not mx.metal.is_available():
+        return None
+    return mx.fast.metal_kernel(
+        name="inkling_short_conv",
+        input_names=["x", "state", "w", "res"],
+        output_names=["out", "new_state"],
+        source=_SHORT_CONV_SRC,
+        ensure_row_contiguous=False,
+    )
+
+
+_short_conv_kernel = _make_short_conv_kernel()
+
+
+class ShortConv(nn.Module):
+    """Depthwise causal convolution with a built-in residual::
+
+        y[t] = x[t] + sum_k w[k] * x[t - (K - 1) + k]
+
+    The decode state is the last ``K - 1`` inputs, kept in slot ``slot`` of the
+    layer's ``ArraysCache``. The weight keeps the ``nn.Conv1d`` layout
+    ``[channels, K, 1]`` of the checkpoints. A few tokens at a time go through
+    one kernel (convolution, residual and state update); longer inputs through
+    the compiled taps. Both accumulate in fp32 and agree after the rounding to
+    the activation dtype (their fp32 sums differ in the last bits).
+    """
+
+    def __init__(self, channels: int, kernel_size: int, slot: int):
+        super().__init__()
+        self.kernel_size = kernel_size
+        self.slot = slot
+        self.weight = mx.zeros((channels, kernel_size, 1))
+
+    def __call__(self, x, cache=None, mask=None, residual=None):
+        B, L, C = x.shape
+        K = self.kernel_size
+        if mask is not None:
+            x = mx.where(mask[..., None], x, 0)
+        state = cache[self.slot] if cache is not None else None
+        if state is None:
+            state = mx.zeros((B, K - 1, C), x.dtype)
+        if (
+            _short_conv_kernel is not None
+            and mx.default_device() == mx.gpu
+            and cache is not None
+            and cache.lengths is None
+            and mask is None
+            and L <= 8
+        ):
+            y, cache[self.slot] = _short_conv_kernel(
+                inputs=[x, state, self.weight, x if residual is None else residual],
+                template=[
+                    ("T", x.dtype),
+                    ("K", K),
+                    ("HAS_RESIDUAL", residual is not None),
+                ],
+                grid=(C, B, 1),
+                threadgroup=(min(C, 256), 1, 1),
+                output_shapes=[(B, L, C), (B, K - 1, C)],
+                output_dtypes=[x.dtype, x.dtype],
+            )
+            return y
+        xp = mx.concatenate([state, x], axis=1)
+        taps = [xp[:, k : k + L] for k in range(K)]
+        weights = [self.weight[:, k, 0] for k in range(K)]
+        if residual is None:
+            y = _short_conv_taps(x, *taps, *weights)
+        else:
+            y = _short_conv_taps_residual(x, residual, *taps, *weights)
+        if cache is not None:
+            if cache.lengths is not None:
+                # Right padded prompts: the state is the last K - 1 inputs of
+                # the valid part of every sequence
+                ends = mx.clip(cache.lengths, 0, L)
+                positions = (ends[:, None] + mx.arange(K - 1))[..., None]
+                state = mx.take_along_axis(xp, positions, axis=1)
+            else:
+                state = xp[:, L:]
+                if L > K:
+                    # Do not keep the whole prompt chunk alive through a view
+                    state = mx.contiguous(state)
+            cache[self.slot] = state
+        return y
+
+
+_BANDED_MASK_SRC = """
+    uint j = thread_position_in_grid.x;   // key
+    uint i = thread_position_in_grid.y;   // query
+    uint bh = thread_position_in_grid.z;  // batch * heads + head
+    uint S = threads_per_grid.x;
+    uint L = threads_per_grid.y;
+    uint H = rel_shape[1];
+    int dist = int(i + S - L) - int(j);
+    T val;
+    if (dist < 0 || (WINDOW > 0 && dist >= WINDOW)) {
+        val = T(-INFINITY);
+    } else if (dist < EXTENT) {
+        uint b = bh / H;
+        uint h = bh % H;
+        val = rel[b * rel_strides[0] + h * rel_strides[1] + i * rel_strides[2]
+                  + uint(EXTENT - 1 - dist) * rel_strides[3]];
+    } else {
+        val = T(0);
+    }
+    out[(bh * L + i) * S + j] = val;
+"""
+
+
+def _make_banded_mask_kernel():
+    if not mx.metal.is_available():
+        return None
+    return mx.fast.metal_kernel(
+        name="inkling_banded_mask",
+        input_names=["rel"],
+        output_names=["out"],
+        source=_BANDED_MASK_SRC,
+        ensure_row_contiguous=False,
+    )
+
+
+_banded_mask_kernel = _make_banded_mask_kernel()
+
+
+def banded_mask(rel_logits, n_keys, window, extent):
+    """Additive attention mask carrying the relative position bias.
+
+    ``rel_logits`` is ``[B, H, L, extent]`` in reversed distance order: column
+    ``extent - 1 - d`` is the bias of a query against the key ``d`` positions
+    back. The ``L`` queries are the last ``L`` of the ``n_keys`` positions. Keys
+    that are in the future, or at least ``window`` positions back when
+    ``window > 0``, get ``-inf``; keys at least ``extent`` positions back get
+    ``0``.
+    """
+    B, H, L, E = rel_logits.shape
+    dtype = rel_logits.dtype
+    if _banded_mask_kernel is not None and mx.default_device() == mx.gpu:
+        return _banded_mask_kernel(
+            inputs=[rel_logits],
+            template=[("T", dtype), ("WINDOW", window), ("EXTENT", E)],
+            grid=(n_keys, L, B * H),
+            threadgroup=(32, 8, 1),
+            output_shapes=[(B, H, L, n_keys)],
+            output_dtypes=[dtype],
+        )[0]
+    dist = (mx.arange(L) + (n_keys - L))[:, None] - mx.arange(n_keys)[None]
+    idx = E - 1 - mx.clip(dist, 0, E - 1)
+    idx = mx.broadcast_to(idx[None, None], (B, H, L, n_keys))
+    bias = mx.take_along_axis(rel_logits, idx, axis=-1)
+    bias = mx.where(dist >= E, mx.array(0, dtype), bias)
+    masked = dist < 0
+    if window > 0:
+        masked = masked | (dist >= window)
+    return mx.where(masked, mx.array(-float("inf"), dtype), bias)
+
+
+class RelativeLogits(nn.Module):
+    """A learned bank of ``d_rel`` bias-vs-distance profiles.
+
+    ``proj_reversed`` is the checkpoint's ``proj`` ``[d_rel, extent]`` with the
+    distance axis reversed (``sanitize`` does that), so that ``r @ proj_reversed``
+    lists the bias of a query against the keys ``extent - 1, ..., 0`` positions
+    back in key order: the bias of a single query against its last ``S`` keys
+    is the last ``S`` columns, no gather or flip needed.
+    """
+
+    def __init__(self, d_rel: int, extent: int):
+        super().__init__()
+        self.proj_reversed = mx.zeros((d_rel, extent))
+
+
+class Attention(nn.Module):
+    def __init__(self, args: TextArgs, layer_idx: int):
+        super().__init__()
+        sliding = args.layer_is_sliding(layer_idx)
+        self.n_heads = (
+            args.swa_num_attention_heads if sliding else args.num_attention_heads
+        )
+        self.n_kv_heads = (
+            args.swa_num_key_value_heads if sliding else args.num_key_value_heads
+        )
+        self.head_dim = args.swa_head_dim if sliding else args.head_dim
+        self.d_rel = args.d_rel
+        self.window = args.sliding_window_size if sliding else 0
+        self.extent = args.sliding_window_size if sliding else args.rel_extent
+        # q and k are per-head RMS normalized so the scale is 1/d, not 1/sqrt(d)
+        self.scale = 1.0 / self.head_dim
+        self.log_scaling_n_floor = None if sliding else args.log_scaling_n_floor
+        self.log_scaling_alpha = args.log_scaling_alpha
+
+        dims = self.n_heads * self.head_dim
+        kv_dims = self.n_kv_heads * self.head_dim
+        self.splits = (dims, dims + 2 * kv_dims)
+        # q, k, v and r are one projection (fused by ``sanitize``)
+        self.qkvr_proj = nn.Linear(
+            args.hidden_size, dims + 2 * kv_dims + self.n_heads * self.d_rel, bias=False
+        )
+        self.wo_ud = nn.Linear(dims, args.hidden_size, bias=False)
+        # k and v go through their short convolutions before the norm and the cache
+        self.kv_sconv = ShortConv(2 * kv_dims, args.sconv_kernel_size, slot=0)
+        self.q_norm = nn.RMSNorm(self.head_dim, eps=args.rms_norm_eps)
+        self.k_norm = nn.RMSNorm(self.head_dim, eps=args.rms_norm_eps)
+        self.rel_logits_proj = RelativeLogits(self.d_rel, self.extent)
+
+    def __call__(self, x, cache=None, conv_cache=None, conv_mask=None, rel_index=None):
+        B, L, _ = x.shape
+        q, kv, r = mx.split(self.qkvr_proj(x), self.splits, axis=-1)
+        kv = self.kv_sconv(kv, conv_cache, conv_mask)
+        k, v = mx.split(kv, 2, axis=-1)
+
+        q = self.q_norm(q.reshape(B, L, self.n_heads, -1)).transpose(0, 2, 1, 3)
+        k = self.k_norm(k.reshape(B, L, self.n_kv_heads, -1)).transpose(0, 2, 1, 3)
+        v = v.reshape(B, L, self.n_kv_heads, -1).transpose(0, 2, 1, 3)
+
+        q_offset = cache.offset if cache is not None else 0
+        # Batched caches mask their padding (and rotation) with a boolean mask
+        # that describes the cache after this update
+        valid = cache.make_mask(L) if hasattr(cache, "left_padding") else None
+        if cache is not None:
+            k, v = cache.update_and_fetch(k, v)
+        S = k.shape[2]
+
+        # Bias of every query against the keys extent - 1 .. 0 positions back
+        r = r.reshape(B, L, self.n_heads, self.d_rel)
+        rel_logits = (r @ self.rel_logits_proj.proj_reversed).transpose(0, 2, 1, 3)
+        if L > 1:
+            mask = banded_mask(rel_logits, S, self.window, self.extent)
+        elif self.window > 0 and cache is not None:
+            # The rotating cache of a sliding layer: gather by slot distance
+            if rel_index is None:
+                rel_index = self.slot_rel_index(cache)
+            mask = mx.take_along_axis(rel_logits, rel_index, axis=-1)
+        elif S <= self.extent:
+            # A single query against the last S keys in temporal order
+            mask = rel_logits[..., self.extent - S :]
+        else:
+            mask = mx.pad(rel_logits, [(0, 0), (0, 0), (0, 0), (S - self.extent, 0)])
+        if valid is not None:
+            mask = mx.where(valid, mask, -float("inf"))
+
+        if self.log_scaling_n_floor is not None:
+            # Long-context log scaling of the logits, tau is 1 below the floor
+            n_floor = self.log_scaling_n_floor
+            if isinstance(q_offset, int):
+                positions = (
+                    (mx.arange(L) + q_offset)[None] if q_offset + L > n_floor else None
+                )
+            else:
+                positions = q_offset[:, None] + mx.arange(L)[None]
+            if positions is not None:
+                tau = (positions + 1).astype(mx.float32) / n_floor
+                tau = 1 + self.log_scaling_alpha * mx.log(mx.maximum(tau, 1))
+                tau = tau.reshape(-1, 1, L, 1)
+                q = (q * tau).astype(q.dtype)
+                mask = (mask * tau).astype(mask.dtype)
+
+        out = scaled_dot_product_attention(
+            q, k, v, cache=cache, scale=self.scale, mask=mask
+        )
+        out = out.transpose(0, 2, 1, 3).reshape(B, L, -1)
+        return self.wo_ud(out)
+
+    def slot_rel_index(self, cache):
+        """The column of the reversed bias bank for every slot of a rotating
+        cache after a single-token update."""
+        return (self.extent - 1 - cache.key_distances())[None, None, None]
+
+
+class DenseMLP(nn.Module):
+    def __init__(self, args: TextArgs):
+        super().__init__()
+        self.gate_proj = nn.Linear(
+            args.hidden_size, args.dense_intermediate_size, bias=False
+        )
+        self.up_proj = nn.Linear(
+            args.hidden_size, args.dense_intermediate_size, bias=False
+        )
+        self.down_proj = nn.Linear(
+            args.dense_intermediate_size, args.hidden_size, bias=False
+        )
+        self.global_scale = mx.ones((1,))
+
+    def __call__(self, x):
+        y = self.down_proj(swiglu(self.gate_proj(x), self.up_proj(x)))
+        return y * self.global_scale.astype(y.dtype)
+
+
+class Router(nn.Module):
+    """Sigmoid router with a selection bias and shared-expert sinks.
+
+    The router runs in fp32: rows ``[0, n_routed)`` of ``weight`` score the
+    routed experts, the remaining ``n_shared`` rows the always-on shared
+    experts.
+    """
+
+    def __init__(self, args: TextArgs):
+        super().__init__()
+        n_total = args.n_routed_experts + args.n_shared_experts
+        self.weight = mx.zeros((n_total, args.hidden_size), dtype=mx.float32)
+        self.bias = mx.zeros((args.n_routed_experts,), dtype=mx.float32)
+        self.global_scale = mx.ones((1,), dtype=mx.float32)
+
+
+@mx.compile
+def _select_experts(logits, bias, global_scale, top_k, route_scale):
+    n_routed = bias.shape[0]
+    routed = logits[:, :n_routed]
+    shared = logits[:, n_routed:]
+    scores = mx.sigmoid(routed) + bias
+    inds = mx.argpartition(-scores, kth=top_k - 1, axis=-1)[:, :top_k]
+    inds = mx.stop_gradient(inds)
+    # Routing weights: softmax of the log-sigmoid of the raw logits over the
+    # selected routed experts and the shared sinks
+    active = mx.concatenate([mx.take_along_axis(routed, inds, axis=-1), shared], -1)
+    weights = mx.softmax(-mx.logaddexp(0.0, -active), axis=-1, precise=True)
+    weights = weights * (route_scale * global_scale)
+    shared_inds = mx.arange(n_routed, logits.shape[1])[None]
+    inds = mx.concatenate(
+        [inds, mx.broadcast_to(shared_inds, (*inds.shape[:-1], shared.shape[-1]))], -1
+    )
+    return inds, weights
+
+
+_ROUTE_SRC = """
+    // One simdgroup per token. Lane l owns the routed experts l, l + 32, ...
+    // Selection: top-K of sigmoid(logit) + bias, ties to the lowest expert
+    // index. Weights: softmax of the log-sigmoid of the raw logits over the
+    // K selected and the S shared (sink) experts, times scale.
+    uint lane = thread_position_in_threadgroup.x;
+    uint n = threadgroup_position_in_grid.x;
+    constexpr uint PER = (R + 31) / 32;
+    const device float* lg = logits + n * (R + S);
+    float score[PER];
+    bool taken[PER];
+    for (uint t = 0; t < PER; ++t) {
+        uint j = lane + 32 * t;
+        taken[t] = j >= R;
+        score[t] = j < R ? 1.0f / (1.0f + metal::exp(-lg[j])) + bias[j] : -INFINITY;
+    }
+    float active[K + S];
+    for (uint k = 0; k < K; ++k) {
+        float best = -INFINITY;
+        uint best_t = 0;
+        for (uint t = 0; t < PER; ++t) {
+            if (!taken[t] && score[t] > best) {
+                best = score[t];
+                best_t = t;
+            }
+        }
+        float group_best = simd_max(best);
+        uint j = simd_min(best == group_best ? lane + 32 * best_t : 0xFFFFFFFFu);
+        if (j == lane + 32 * best_t) {
+            taken[best_t] = true;
+        }
+        if (lane == 0) {
+            inds[n * (K + S) + k] = j;
+        }
+        active[k] = lg[j];
+    }
+    for (uint i = 0; i < S; ++i) {
+        active[K + i] = lg[R + i];
+        if (lane == 0) {
+            inds[n * (K + S) + K + i] = R + i;
+        }
+    }
+    if (lane == 0) {
+        float lp[K + S];
+        float m = -INFINITY;
+        for (uint i = 0; i < K + S; ++i) {
+            float a = active[i];  // log sigmoid(a) = -softplus(-a)
+            lp[i] = -(metal::max(-a, 0.0f) + metal::log(1.0f + metal::exp(-metal::abs(a))));
+            m = metal::max(m, lp[i]);
+        }
+        float total = 0.0f;
+        for (uint i = 0; i < K + S; ++i) {
+            total += metal::exp(lp[i] - m);
+        }
+        for (uint i = 0; i < K + S; ++i) {
+            weights[n * (K + S) + i] = metal::exp(lp[i] - m) / total * scale[0];
+        }
+    }
+"""
+
+
+def _make_route_kernel():
+    if not mx.metal.is_available():
+        return None
+    return mx.fast.metal_kernel(
+        name="inkling_route",
+        input_names=["logits", "bias", "scale"],
+        output_names=["inds", "weights"],
+        source=_ROUTE_SRC,
+    )
+
+
+_route_kernel = _make_route_kernel()
+
+
+def select_experts(logits, bias, global_scale, top_k, route_scale):
+    """Expert indices ``[N, top_k + n_shared]`` (the shared experts last) and
+    their routing weights from fp32 router logits ``[N, n_routed + n_shared]``."""
+    N, n_total = logits.shape
+    n_routed = bias.shape[0]
+    if _route_kernel is not None and mx.default_device() == mx.gpu:
+        return _route_kernel(
+            inputs=[logits, bias, route_scale * global_scale],
+            template=[("R", n_routed), ("S", n_total - n_routed), ("K", top_k)],
+            grid=(32 * N, 1, 1),
+            threadgroup=(32, 1, 1),
+            output_shapes=[(N, top_k + n_total - n_routed)] * 2,
+            output_dtypes=[mx.uint32, mx.float32],
+        )
+    return _select_experts(logits, bias, global_scale, top_k, route_scale)
+
+
+class MoE(nn.Module):
+    """Top-k routed experts plus always-on shared experts.
+
+    The shared experts are stored after the routed ones in ``experts`` and are
+    selected for every token, so one ``SwitchGLU`` call serves both (measured
+    faster than a separate dense SwiGLU for them at decode and at prefill).
+    """
+
+    def __init__(self, args: TextArgs):
+        super().__init__()
+        self.top_k = args.num_experts_per_tok
+        self.route_scale = args.route_scale
+        self.gate = Router(args)
+        self.experts = SwitchGLU(
+            args.hidden_size,
+            args.intermediate_size,
+            args.n_routed_experts + args.n_shared_experts,
+        )
+
+    def __call__(self, x):
+        B, L, D = x.shape
+        x = x.reshape(-1, D)
+        logits = x.astype(mx.float32) @ self.gate.weight.astype(mx.float32).T
+        inds, weights = select_experts(
+            logits, self.gate.bias, self.gate.global_scale, self.top_k, self.route_scale
+        )
+        y = self.experts(x, inds)
+        y = (y * weights[..., None].astype(y.dtype)).sum(axis=-2)
+        return y.reshape(B, L, D)
+
+
+class DecoderLayer(nn.Module):
+    def __init__(self, args: TextArgs, layer_idx: int):
+        super().__init__()
+        self.attn = Attention(args, layer_idx)
+        self.mlp = DenseMLP(args) if args.layer_is_dense(layer_idx) else MoE(args)
+        self.attn_norm = nn.RMSNorm(args.hidden_size, eps=args.rms_norm_eps)
+        self.mlp_norm = nn.RMSNorm(args.hidden_size, eps=args.rms_norm_eps)
+        self.attn_sconv = ShortConv(args.hidden_size, args.sconv_kernel_size, slot=1)
+        self.mlp_sconv = ShortConv(args.hidden_size, args.sconv_kernel_size, slot=2)
+
+    def __call__(self, x, cache=None, rel_index=None):
+        kv_cache = conv_cache = conv_mask = None
+        if cache is not None:
+            kv_cache, conv_cache = cache[0], cache[1]
+            if conv_cache.lengths is not None or conv_cache.left_padding is not None:
+                conv_mask = conv_cache.make_mask(x.shape[1])
+        r = self.attn(self.attn_norm(x), kv_cache, conv_cache, conv_mask, rel_index)
+        h = self.attn_sconv(r, conv_cache, conv_mask, residual=x)
+        r = self.mlp(self.mlp_norm(h))
+        out = self.mlp_sconv(r, conv_cache, conv_mask, residual=h)
+        if conv_cache is not None:
+            conv_cache.advance(x.shape[1])
+        return out
+
+
+class InklingTextModel(nn.Module):
+    def __init__(self, args: TextArgs):
+        super().__init__()
+        self.args = args
+        self.embed = nn.Embedding(args.vocab_size, args.hidden_size)
+        if args.use_embed_norm:
+            self.embed_norm = nn.RMSNorm(args.hidden_size, eps=args.rms_norm_eps)
+        self.layers = [DecoderLayer(args, i) for i in range(args.num_hidden_layers)]
+        self.norm = nn.RMSNorm(args.hidden_size, eps=args.rms_norm_eps)
+        self.unembed = nn.Linear(args.hidden_size, args.vocab_size, bias=False)
+        self.first_sliding = next(
+            (i for i in range(args.num_hidden_layers) if args.layer_is_sliding(i)), None
+        )
+
+    def embed_tokens(self, inputs):
+        h = self.embed(inputs)
+        if self.args.use_embed_norm:
+            h = self.embed_norm(h)
+        return h
+
+    def __call__(self, inputs, cache=None, input_embeddings=None):
+        h = (
+            input_embeddings
+            if input_embeddings is not None
+            else self.embed_tokens(inputs)
+        )
+        if cache is None:
+            cache = [None] * len(self.layers)
+        # The sliding layers' rotating caches move in lockstep, so the slot
+        # index of the first one serves all of them for a single token
+        rel_index = None
+        for i, (layer, c) in enumerate(zip(self.layers, cache)):
+            h = layer(h, c, rel_index if layer.attn.window > 0 else None)
+            if i == self.first_sliding and c is not None and h.shape[1] == 1:
+                rel_index = layer.attn.slot_rel_index(c[0])
+        h = self.norm(h) * (1.0 / self.args.logits_mup_width_multiplier)
+        logits = self.unembed(h)
+        if self.args.unpadded_vocab_size is not None:
+            logits = logits[..., : self.args.unpadded_vocab_size]
+        return logits
+
+
+class InklingModel(nn.Module):
+    def __init__(self, args: TextArgs):
+        super().__init__()
+        self.llm = InklingTextModel(args)
+
+
+class Model(nn.Module):
+    def __init__(self, args: ModelArgs):
+        super().__init__()
+        self.args = args
+        self.model_type = args.model_type
+        self.model = InklingModel(args.text_config)
+
+    def __call__(self, inputs, cache=None, input_embeddings=None):
+        return self.model.llm(inputs, cache, input_embeddings)
+
+    @property
+    def layers(self):
+        return self.model.llm.layers
+
+    def make_cache(self):
+        args = self.args.text_config
+        caches = []
+        for i in range(args.num_hidden_layers):
+            if args.layer_is_sliding(i):
+                kv = RotatingKVCache(max_size=args.sliding_window_size)
+            else:
+                kv = KVCache()
+            caches.append(CacheList(kv, ArraysCache(size=3)))
+        return caches
+
+    def sanitize(self, weights):
+        """Accepts the mlx-community layout (split gate/up, ``[C, K, 1]`` convs)
+        and the HF source layout (interleaved ``w13`` rows, ``[C, 1, K]`` convs),
+        then fuses q/k/v/r, k|v convs and routed|shared experts."""
+        args = self.args.text_config
+        drop = ("model.visual.", "model.audio.", "model.mtp.")
+        weights = {k: v for k, v in weights.items() if not k.startswith(drop)}
+
+        def split_gate_up(w):
+            # Fused gate/up rows are interleaved: [g0, u0, g1, u1, ...]
+            w = w.reshape(*w.shape[:-2], w.shape[-2] // 2, 2, w.shape[-1])
+            return mx.contiguous(w[..., 0, :]), mx.contiguous(w[..., 1, :])
+
+        out = {}
+        for k, v in weights.items():
+            if k.endswith("_sconv.weight") and v.shape[1] == 1 and v.shape[2] > 1:
+                v = v.swapaxes(1, 2)  # torch [C, 1, K] -> [C, K, 1]
+            if k.endswith(".mlp.w13_dn.weight"):
+                base = k[: -len("w13_dn.weight")]
+                out[base + "gate_proj.weight"], out[base + "up_proj.weight"] = (
+                    split_gate_up(v)
+                )
+            elif k.endswith(".mlp.w2_md.weight"):
+                out[k[: -len("w2_md.weight")] + "down_proj.weight"] = v
+            elif k.endswith(".experts.w13_weight"):
+                base = k[: -len("w13_weight")]
+                out[base + "gate_proj.weight"], out[base + "up_proj.weight"] = (
+                    split_gate_up(v)
+                )
+            elif k.endswith(".experts.w2_weight"):
+                out[k[: -len("w2_weight")] + "down_proj.weight"] = v
+            elif k.endswith(".shared_experts.shared_w13_weight"):
+                base = k[: -len("shared_w13_weight")]
+                out[base + "gate_proj.weight"], out[base + "up_proj.weight"] = (
+                    split_gate_up(v)
+                )
+            elif k.endswith(".shared_experts.shared_w2_weight"):
+                out[k[: -len("shared_w2_weight")] + "down_proj.weight"] = v
+            elif k.endswith(".mlp.gate.weight"):
+                out[k] = v.astype(mx.float32)
+            elif k.endswith(".rel_logits_proj.proj"):
+                out[k + "_reversed"] = v[:, ::-1]
+            else:
+                out[k] = v
+        weights = out
+
+        def fuse(prefix, names, fused):
+            # Concatenate the (possibly quantized) tensors of ``names`` into
+            # ``fused`` along the first axis; every row keeps its own
+            # quantization groups so this is exact.
+            leaves = ("weight", "scales", "biases")
+            present = [
+                leaf
+                for leaf in leaves
+                if any(f"{prefix}{n}.{leaf}" in weights for n in names)
+            ]
+            for leaf in present:
+                parts = [weights.pop(f"{prefix}{n}.{leaf}", None) for n in names]
+                if any(p is None for p in parts):
+                    raise ValueError(f"Incomplete {leaf} tensors for {prefix}{fused}")
+                if any(p.shape[1:] != parts[0].shape[1:] for p in parts):
+                    raise ValueError(
+                        f"Cannot fuse {prefix}{fused}.{leaf}: quantization differs"
+                    )
+                weights[f"{prefix}{fused}.{leaf}"] = mx.concatenate(parts, axis=0)
+
+        for i in range(args.num_hidden_layers):
+            prefix = f"model.llm.layers.{i}."
+            attn = prefix + "attn."
+            if f"{attn}wq_du.weight" in weights:
+                fuse(attn, ["wq_du", "wk_dv", "wv_dv", "wr_du"], "qkvr_proj")
+            if f"{attn}k_sconv.weight" in weights:
+                fuse(attn, ["k_sconv", "v_sconv"], "kv_sconv")
+            mlp = prefix + "mlp."
+            if f"{mlp}shared_experts.gate_proj.weight" in weights:
+                for proj in ("gate_proj", "up_proj", "down_proj"):
+                    fuse(
+                        mlp,
+                        [f"experts.{proj}", f"shared_experts.{proj}"],
+                        f"experts.{proj}",
+                    )
+        return weights
+
+    @property
+    def cast_predicate(self):
+        def predicate(path):
+            # The router runs in fp32
+            return ".mlp.gate." not in path
+
+        return predicate
+
+    @property
+    def quant_predicate(self):
+        def predicate(path, _):
+            # Attention is the dominant error source below 8 bits
+            if path.endswith(
+                (".attn.qkvr_proj", ".attn.wo_ud", "llm.embed", "llm.unembed")
+            ):
+                return {"group_size": 64, "bits": 8}
+            return True
+
+        return predicate
