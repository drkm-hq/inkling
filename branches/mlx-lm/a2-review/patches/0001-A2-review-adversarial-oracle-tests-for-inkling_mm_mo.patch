+    def test_banded_mask_vs_oracle(self):
+        rs = np.random.RandomState(3)
+        cases = [  # (B, H, Lq, S, window, extent)
+            (1, 2, 1, 600, 512, 512),
+            (2, 2, 8, 2000, 512, 512),
+            (1, 3, 37, 548, 512, 512),
+            (1, 2, 600, 1111, 512, 512),
+            (1, 2, 1, 1500, 0, 1024),
+            (2, 2, 8, 1030, 0, 1024),
+            (1, 2, 37, 1100, 0, 1024),
+            (1, 2, 1300, 1300, 0, 1024),
+            (2, 2, 3, 10, 4, 4),
+            (1, 2, 12, 12, 4, 4),
+            (1, 2, 5, 12, 0, 8),
+            (1, 2, 1, 1, 4, 4),
+        ]
+        for dev in self.devices():
+            for B, H, L, S, window, extent in cases:
+                r = rs.standard_normal((B, L, H, 4))
+                proj = rs.standard_normal((4, extent))
+                q_pos = np.arange(S - L, S)
+                k_pos = np.arange(S)
+                ref = R.rel_bias_ref(r, proj, q_pos, k_pos)
+                dist = q_pos[:, None] - k_pos[None]
+                masked = dist < 0
+                if window > 0:
+                    masked |= dist >= window
+                ref = np.where(masked[None, None], -np.inf, ref)
+                rl = np.einsum("bihd,de->bhie", r, proj)[..., ::-1].copy()  # K2's reversed bank
+                out = np.array(M.banded_mask(mx.array(rl.astype(np.float32)), S, window, extent), np.float64)
+                self.assertEqual(out.shape, ref.shape)
+                np.testing.assert_array_equal(np.isinf(out), np.isinf(ref), f"{(B, H, L, S, window, extent)} inf pattern")
+                fin = np.isfinite(ref)
+                self.check(f"{dev}: banded_mask {(B, H, L, S, window, extent)}", out[fin], ref[fin])
+
+    def test_router_vs_oracle(self):
+        rs = np.random.RandomState(5)
+        R_, S_, K_ = 256, 2, 6
+        for dev in self.devices():
+            for N in (1, 37, 300):
+                x = rs.standard_normal((N, 16))
+                gw = rs.standard_normal((R_ + S_, 16)) * 0.3
+                logits = (x @ gw.T).astype(np.float32)
+                bias = (rs.standard_normal(R_) * 0.05).astype(np.float32)
+                clear = [1, 50, 100, 200, 255]
+                bias[clear + [5, 9, 17, 29]] = 0
+                # row 0: five clear winners, then an exact tie (5 vs 9) for the
+                # sixth slot; row 1: a near tie (17 above 29 by ~1e-4 in score)
+                for row, pair, delta in [(0, (5, 9), 0.0), (1, (17, 29), 4e-4)]:
+                    if row >= N:
+                        continue
+                    logits[row, :R_] = rs.uniform(-6, -4, R_)
+                    logits[row, clear] = [3, 2.5, 2, 1.5, 1.0]
+                    logits[row, pair[0]] = np.float32(0.5 + delta)
+                    logits[row, pair[1]] = np.float32(0.5)
+                gs = np.array([1.3], np.float32)
+                # the oracle sees exactly the float32 logits (identity gate)
+                idx, tw, gamma, _ = R.router_ref(
+                    logits.astype(np.float64), np.eye(R_ + S_), bias.astype(np.float64), gs, 8.0, K_, S_
+                )
+                for name, fn in [("kernel", M.select_experts), ("compiled", M._select_experts)]:
+                    if name == "kernel" and dev == "cpu":
+                        continue
+                    inds, w = fn(mx.array(logits), mx.array(bias), mx.array(gs), K_, 8.0)
+                    inds, w = np.array(inds), np.array(w, np.float64)
+                    # routed indices [N, K] (00cdad1) or routed + shared [N, K + S] (cce0834)
+                    self.assertIn(inds.shape, [(N, K_), (N, K_ + S_)])
+                    self.assertEqual(w.shape, (N, K_ + S_))
+                    if inds.shape[1] == K_ + S_:
+                        np.testing.assert_array_equal(inds[:, K_:], np.broadcast_to(np.arange(R_, R_ + S_), (N, S_)))
+                    nbad = []
+                    werr = 0.0
+                    for i in range(N):
+                        if set(inds[i, :K_].tolist()) != set(idx[i].tolist()):
+                            nbad.append(i)
+                            continue
+                        got = dict(zip(inds[i, :K_].tolist() + list(range(R_, R_ + S_)), w[i]))
+                        ref = dict(zip(idx[i].tolist() + list(range(R_, R_ + S_)), np.concatenate([tw[i], gamma[i]])))
+                        werr = max(werr, max(abs(got[e] - ref[e]) / abs(ref[e]) for e in ref))
+                    REPORT.append((f"{dev}: router {name} N={N}: expert sets differ from the oracle on rows {nbad} (row 0 holds the exact tie); max weight rel err {werr:.2e}", werr, 1e-5))
+                    # The kernel documents lowest-index ties; argpartition does not
+                    self.assertEqual([i for i in nbad if i != 0 or name == "kernel"], [], f"{name} N={N}")
+                    self.assertLessEqual(werr, 1e-5)
+
+    def test_short_conv_kernel_equals_fallback(self):
+        rs = np.random.RandomState(9)
+        C, K = 48, 4
+        for dev in self.devices():
+            if dev != "gpu" or M._short_conv_kernel is None:
+                continue
+            for dtype in (mx.bfloat16, mx.float16, mx.float32):
+                conv = M.ShortConv(C, K, slot=0)
+                conv.weight = mx.array(rs.standard_normal((C, K, 1)).astype(np.float32) * 0.3)
+                for L in (1, 2, 5, 8, 9, 20):
+                    x = mx.array(rs.standard_normal((2, L, C)).astype(np.float32)).astype(dtype)
+                    res = mx.array(rs.standard_normal((2, L, C)).astype(np.float32)).astype(dtype)
+                    st = mx.array(rs.standard_normal((2, K - 1, C)).astype(np.float32)).astype(dtype)
+                    outs = []
+                    for use_kernel in (True, False):
+                        saved = M._short_conv_kernel
+                        if not use_kernel:
+                            M._short_conv_kernel = None
+                        try:
+                            cache = ArraysCache(3)
+                            cache[0] = st
+                            y = conv(x, cache, residual=res)
+                            mx.eval(y, cache[0])
+                            outs.append((y, cache[0]))
+                        finally:
+                            M._short_conv_kernel = saved
+                    (yk, sk), (yf, sf) = outs
+                    self.assertEqual(yk.dtype, dtype)
+                    self.assertEqual(sk.dtype, sf.dtype)
+                    # K2 documents the two paths as bit-identical; record whether
+                    # they are, assert they agree to one rounding of the dtype
+                    same = bool(mx.array_equal(yk, yf))
+                    ulp = {mx.float32: 1e-6, mx.float16: 2.0**-10, mx.bfloat16: 2.0**-7}[dtype]
+                    REPORT.append((f"{dev}: ShortConv {dtype} L={L} kernel vs fallback (bit-identical: {same})", rel(yk, yf), ulp))
+                    self.assertLessEqual(rel(yk, yf), ulp, f"{dtype} L={L}: kernel vs fallback")
+                    self.assertTrue(mx.array_equal(sk, sf), f"{dtype} L={L}: state differs")
+                    # fp32 against the oracle (the kernel path when L <= 8)
+                    if dtype == mx.float32:
+                        y_ref, s_ref = R.sconv_ref(np.array(x), np.array(conv.weight)[:, :, 0], np.array(st))
+                        y_ref = y_ref + np.array(res)
+                        self.check(f"{dev}: ShortConv fp32 L={L} vs oracle (+residual)", yk, y_ref)
+                        self.check(f"{dev}: ShortConv state L={L}", sk, s_ref, 0.0)
