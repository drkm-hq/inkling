+    # -- reduced precision and quantization ----------------------------------------
+
+    def test_reduced_precision_paths(self):
+        # bf16 / fp16 through the Metal kernels. On this tiny random model the
+        # routed expert sets flip on near ties at reduced precision, which the
+        # MoE amplifies, so the oracle error is split by whether a token's
+        # routing matched the fp32 model. Asserted: the kernel paths equal the
+        # pure-MLX fallbacks, and the un-flipped tokens stay close.
+        ids, chunks = IDS40[:, :16], [7] + [1] * 9
+        ref = oracle_forward(ids)
+        for dev in self.devices():
+            if dev != "gpu":
+                continue
+            out32, routes32 = forward_with_routes(build_model(), ids, chunks)
+            self.check(f"{dev}: fp32 (routes recorded) vs oracle", out32, ref)
+            for dtype in (mx.bfloat16, mx.float16):
+                model = build_model(dtype=dtype)
+                out, routes = forward_with_routes(model, ids, chunks)
+                flipped = {(b, pos) for (i, b, pos), r in routes.items() if routes32[(i, b, pos)] != r}
+                keep = np.ones(ids.shape, bool)
+                for b, pos in flipped:
+                    keep[b, pos] = False
+                e_all = rel(out, ref)
+                e_keep = rel(out[keep], ref[keep])
+                REPORT.append((f"{dev}: {dtype} vs oracle, all tokens ({len(flipped)}/{ids.size} tokens route differently from fp32)", e_all, 1.0))
+                # recorded, judged like-for-like against mlx-vlm in review/a2_tiny_bf16.py
+                REPORT.append((f"{dev}: {dtype} vs oracle on tokens routed like fp32 (information only)", e_keep, 1.0))
+                saved = (M._short_conv_kernel, M._route_kernel, M._banded_mask_kernel)
+                try:
+                    M._short_conv_kernel = M._route_kernel = M._banded_mask_kernel = None
+                    out2, routes2 = forward_with_routes(model, ids, chunks)
+                finally:
+                    M._short_conv_kernel, M._route_kernel, M._banded_mask_kernel = saved
+                self.assertEqual(routes2, routes, f"{dtype}: kernel and fallback routing differ")
+                self.check(f"{dev}: {dtype} kernels vs fallbacks", out2, out, 1e-2)
+
+    def test_quantized_tiny(self):
+        # K2's quant_predicate: attention / embed / unembed at 8 bits g64,
+        # everything else at the requested (4 bits, g32); the fused qkvr rows and
+        # the 10-expert SwitchGLU through gather_qmm vs the dequantized model.
+        for dev in self.devices():
+            model = build_model()
+            qmodel, qcfg = quantize_model(model, {}, 32, 4)
+            kinds = {k: type(m).__name__ for k, m in qmodel.named_modules() if "Quantized" in type(m).__name__}
+            self.assertIn("model.llm.layers.0.attn.qkvr_proj", kinds)
+            self.assertEqual(qcfg["quantization"]["model.llm.layers.0.attn.qkvr_proj"], {"group_size": 64, "bits": 8})
+            self.assertIn("model.llm.layers.1.mlp.experts.gate_proj", kinds)
+            self.assertNotIn("model.llm.layers.1.mlp.gate", kinds)
+            self.assertTrue(all(not k.endswith("sconv") for k in kinds))
+            dq = dequantize_model(copy.deepcopy(qmodel))
+            mx.eval(qmodel.parameters(), dq.parameters())
+            for name, chunks in [("full", None), ("decode 7 + 1 x 9", [7] + [1] * 9)]:
+                self.check(f"{dev}: quantized tiny model {name} vs its dequantized twin", model_forward(qmodel, IDS40[:, :16], chunks), model_forward(dq, IDS40[:, :16], chunks), 2e-5)
+            # the dequantized twin is still close to the oracle (4-bit experts)
+            e = rel(model_forward(dq, IDS40[:, :16]), oracle_forward(IDS40[:, :16]))
+            REPORT.append((f"{dev}: dequantized 4-bit tiny model vs oracle (information only)", e, 1.0))
+
+
+def _print_report():
+    if not REPORT:
+        return
+    print("\nA2 report (rel error, tolerance):")
+    for name, e, tol in REPORT:
+        flag = "" if e <= tol else "   <-- FAIL"
+        print(f"  {e:.3e} <= {tol:.0e}  {name}{flag}")
+
+
+import atexit  # noqa: E402
+
+atexit.register(_print_report)
+
+if __name__ == "__main__":
+    unittest.main()
