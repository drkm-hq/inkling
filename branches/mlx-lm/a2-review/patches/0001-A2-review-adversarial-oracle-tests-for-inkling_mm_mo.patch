+                rb = R.model_forward_ref(PARAMS, OCFG, tok[1:], positions=np.array([lb + t]), caches=ob)
+                self.check(f"{dev}: left-padded batch decode step {t} row A", lp[0], ra["logits"][0])
+                self.check(f"{dev}: left-padded batch decode step {t} row B", lp[1], rb["logits"][0])
