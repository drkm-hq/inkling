+    def test_generate_step(self):
+        prompt = IDS40[0, :11]
+        for dev in self.devices():
+            model = build_model()
+            toks, lps = [], []
+            for tok, lp in generate_step(mx.array(prompt), model, max_tokens=8, sampler=make_sampler(0.0), prefill_step_size=5):
+                toks.append(int(tok))
+                lps.append(np.array(lp, np.float64))
+            seq = np.concatenate([prompt, toks])[None]
+            ref = oracle_forward(seq)[0]
+            ref = ref - np.log(np.exp(ref - ref.max(-1, keepdims=True)).sum(-1, keepdims=True)) - ref.max(-1, keepdims=True)
+            for t in range(8):
+                pos = len(prompt) - 1 + t
+                self.check(f"{dev}: generate_step logprobs step {t}", lps[t], ref[pos], 1e-4)
+                top = np.argsort(-ref[pos])[:2]
+                if ref[pos][top[0]] - ref[pos][top[1]] > 1e-3:
+                    self.assertEqual(toks[t], int(top[0]), f"step {t}")
