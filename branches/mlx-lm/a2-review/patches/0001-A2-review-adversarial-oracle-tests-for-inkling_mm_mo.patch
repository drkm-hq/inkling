+    def test_batched_right_padded_prefill_chunked(self):
+        # The server's prompt path: merged empty caches, prepare(lengths,
+        # right_padding), chunked prefill (chunk 4 over 11 tokens so the short
+        # sequence's lengths go negative), finalize, then decode.
+        la, lb, chunk = 11, 5, 4
+        toks = np.zeros((2, la), np.int64)
+        toks[0] = IDS40[0, :la]
+        toks[1, :lb] = IDS40[1, :lb]
+        for dev in self.devices():
+            model = build_model()
+            caches = [make_prompt_cache(model) for _ in range(2)]
+            merged = [CacheList.merge(list(cs)) for cs in zip(*caches)]
+            for c in merged:
+                c.prepare(lengths=[la, lb], right_padding=[0, la - lb])
+            outs = []
+            for s in range(0, la, chunk):
+                outs.append(model(mx.array(toks[:, s : s + chunk]), cache=merged))
+                mx.eval([c.state for c in merged])
+            for c in merged:
+                c.finalize()
+            mx.eval([c.state for c in merged])
+            lp = np.array(mx.concatenate(outs, 1), np.float64)
+            self.check(f"{dev}: right-padded chunked prefill row A", lp[0, :la], oracle_forward(toks[:1, :la])[0])
+            self.check(f"{dev}: right-padded chunked prefill row B (valid part)", lp[1, :lb], oracle_forward(toks[1:, :lb])[0])
+            oa = R.model_forward_ref(PARAMS, OCFG, toks[:1, :la])["caches"]
+            ob = R.model_forward_ref(PARAMS, OCFG, toks[1:, :lb])["caches"]
+            for t in range(6):
+                tok = np.stack([IDS40[0, la + t : la + t + 1], IDS40[1, lb + t : lb + t + 1]])
+                lp = np.array(model(mx.array(tok), cache=merged), np.float64)
+                ra = R.model_forward_ref(PARAMS, OCFG, tok[:1], positions=np.array([la + t]), caches=oa)
+                rb = R.model_forward_ref(PARAMS, OCFG, tok[1:], positions=np.array([lb + t]), caches=ob)
+                self.check(f"{dev}: decode after right-padded prefill step {t} row A", lp[0], ra["logits"][0])
+                self.check(f"{dev}: decode after right-padded prefill step {t} row B", lp[1], rb["logits"][0])
