+@pytest.mark.parametrize("accepted", [0, 1, 3])
+def test_speculative_rollback_after_compactions_matches_138d761_replay(accepted):
+    """Verify 4 tokens, roll back to ``accepted + 1``, and continue: must equal
+    the 138d761 model fed the same token stream with the same chunking (the
+    rollback replays the kept tokens as one call, so the reference does too)."""
+    model = tiny_model(window=8)
+    ref = old_model(model)
+    ids = tokens(600)
+    cache, full = model.make_cache(), full_cache(ref)
+    model(ids, cache=cache)
+    ref(ids, cache=full)
+    y = ids[:, -1:]
+    for _ in range(300):  # several compactions of the 8-token windows
+        ref(y, cache=full)
+        y = mx.argmax(model(y, cache=cache).logits[:, -1], axis=-1)[:, None]
+    assert all(c.caches[0].start_position > 0 for c in cache if isinstance(c.caches[0], SlidingWindowKVCache))
+    verify = tokens(4, seed=7)
+    hidden, _, state = model.speculative_verify_hidden(verify, cache)
+    assert hidden.shape == (1, 4, 32)
+    assert [c.caches[0].offset for c in cache] == [904] * 3
+    assert model.rollback_speculative_cache(cache, state, accepted, 4) == accepted
+    keep = accepted + 1
+    assert [c.caches[0].offset for c in cache] == [900 + keep] * 3
+    ref(verify[:, :keep], cache=full)
+    nxt = tokens(5, seed=9)
+    for step in range(5):
+        got = model(nxt[:, step : step + 1], cache=cache).logits
+        want = ref(nxt[:, step : step + 1], cache=full).logits
+        assert exact(got, want), f"step {step}: {max_abs_diff(got, want):.3e}"
+
