+@pytest.mark.parametrize("window", [8, 512])
+@pytest.mark.parametrize("chunk", [7, 64, 513])
+def test_batch_of_three_left_padded_rows_matches_single_rows(window, chunk):
+    model = tiny_model(window=window)
+    ref = old_model(model)
+    rows = [tokens(600, seed=3), tokens(591, seed=4), tokens(300, seed=5)]
+    width = max(r.shape[1] for r in rows)
+    pads = [width - r.shape[1] for r in rows]
+    batch_ids = mx.concatenate(
+        [
+            mx.concatenate([mx.zeros((1, p), mx.int32), r], axis=1) if p else r
+            for r, p in zip(rows, pads)
+        ]
+    )
+    cache = _make_cache(model, left_padding=pads)
+    assert isinstance(cache[0].caches[0], BatchSlidingWindowKVCache)
+    batched = run(model, batch_ids, cache, chunk)
+    singles = []
+    for row, (ids, p) in enumerate(zip(rows, pads)):
+        single = full_cache(ref)
+        close(batched[row : row + 1, p:], run(ref, ids, single, chunk))
+        singles.append(single)
+    y = batch_ids[:, -1:]
+    steps = 300 if window == 8 else 200
+    for step in range(steps):
+        got = model(y, cache=cache).logits
+        for row, single in enumerate(singles):
+            want = ref(y[row : row + 1], cache=single).logits
+            close(got[row : row + 1], want)
+        y = mx.argmax(got[:, -1], axis=-1)[:, None]
+    kv = cache[0].caches[0]
+    assert kv.start_position > 0 and kv.keys.shape[2] <= 1024
+    assert kv.offset.tolist() == [600 + steps, 591 + steps, 300 + steps]
+
+
+# ---------------------------------------------------------------- cache level
+
+H, D = 2, 4
+
+
+def kv(positions, batch=1):
+    positions = list(positions)
+    pos = mx.array(positions, dtype=mx.float32)
+    rows = mx.arange(batch, dtype=mx.float32)[:, None, None, None] * 1000
+    base = mx.broadcast_to(pos[None, None, :, None], (batch, H, len(positions), D))
+    return base + rows, base + rows + 0.5
+
+
+def positions_of(keys):
+    return keys[0, 0, :, 0].tolist()
+
+
+def random_schedule(seed, total=1500):
+    rng = np.random.default_rng(seed)
+    out = []
+    while sum(out) < total:
+        kind = rng.integers(0, 4)
+        out.append(int([1, rng.integers(1, 9), rng.integers(9, 300), rng.integers(300, 700)][kind]))
+    return out
+
+
+@pytest.mark.parametrize("window", [8, 512])
+@pytest.mark.parametrize("buffer_size", [0, 1, 256])
+@pytest.mark.parametrize("seed", range(4))
+def test_window_coverage_invariant_under_random_schedules(window, buffer_size, seed):
+    """After every update the returned keys are a suffix of the reference and
+    the last ``window - 1`` keys before the first incoming token are present."""
+    cache = SlidingWindowKVCache(window, buffer_size=buffer_size)
+    reference = KVCache()
+    pos = 0
+    largest = 0
+    for L in random_schedule(seed):
+        largest = max(largest, L)
+        k, v = kv(range(pos, pos + L))
+        ref_k, _ = reference.update_and_fetch(k, v)
+        out_k, out_v = cache.update_and_fetch(k, v)
+        n = out_k.shape[2]
+        assert positions_of(out_k) == positions_of(ref_k)[-n:]
+        assert positions_of(out_v) == [p + 0.5 for p in positions_of(ref_k)[-n:]]
+        retained_old = n - L
+        assert retained_old >= min(window - 1, pos), (pos, L, retained_old)
+        assert retained_old <= window - 1 + max(buffer_size, L)
+        pos += L
+        assert cache.offset == pos
+        assert cache.start_position + cache._idx == cache.offset
+        # Capacity is set by the largest chunk seen so far and never shrinks.
+        assert cache.keys.shape[2] <= cache._capacity_for(window + max(buffer_size, largest))
+
+
+def test_trim_inside_the_last_update_keeps_coverage_and_beyond_it_is_guarded():
+    """trim() is safe back to the first token of the update that last compacted
+    (the speculative use); beyond that the window loses keys silently, and the
+    dispatch reuse guard must decline such a cache."""
+    cache = SlidingWindowKVCache(8, buffer_size=4)
+    cache.update_and_fetch(*kv(range(20)))
+    for pos in range(20, 26):
+        cache.update_and_fetch(*kv([pos]))
+    assert cache.start_position == 18 and cache.offset == 26
+    # The last update added one token: a 1-token trim keeps the window whole.
+    assert cache.trim(1) == 1
+    out_k, _ = cache.update_and_fetch(*kv([125]))
+    assert positions_of(out_k) == [18.0, 19.0, 20.0, 21.0, 22.0, 23.0, 24.0, 125.0]
+    # A deeper trim (4 tokens, past the compaction point at 25) exposes a hole:
+    # the query at 22 needs keys 15..21 but 15, 16, 17 were evicted.
+    assert cache.trim(4) == 4
+    assert cache.offset == 22
+    out_k, _ = cache.update_and_fetch(*kv([122]))
+    visible = positions_of(out_k)
+    assert visible == [18.0, 19.0, 20.0, 21.0, 122.0]  # 4 old keys, not 7
+    assert len(visible) - 1 < 7, "coverage is lost after a deep trim"
+    assert cache.is_trimmable()
+    assert not dispatch._cache_fully_retained(cache)
+    assert dispatch._prefix_cache_trim_amount([cache], 10) is None
+
