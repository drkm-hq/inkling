+def test_prefix_cache_trim_amount_on_inkling_layer_entries():
+    model = tiny_model()
+    cache = model.make_cache()
+    model(tokens(40), cache=cache)
+    assert dispatch._prefix_cache_trim_amount(cache, 40) == 0  # exact continuation
+    # Shorter shared prefix: the conv states cannot be trimmed -> cold prefill.
+    assert dispatch._prefix_cache_trim_amount(cache, 30) is None
+    # 138d761 layout: the layer entry has no offset, so the stale cache was
+    # reported reusable untrimmed (cached_len read as 0).
+    stale = full_cache(model)
+    model(tokens(40), cache=stale)
+    assert dispatch._prefix_cache_trim_amount(stale, 30) == 0
+
