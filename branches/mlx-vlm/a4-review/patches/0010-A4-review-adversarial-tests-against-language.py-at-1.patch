@@ -0,0 +1,22 @@
+"""A4: chunked parameter eval equals a one-shot eval, including shared graphs."""
+
+import mlx.core as mx
+from mlx.utils import tree_flatten
+
+from mlx_vlm import utils
+from mlx_vlm.tests._a4_common import exact
+
+
+def build():
+    mx.random.seed(0)
+    base = mx.random.normal((64, 64))
+    return {"a": base * 2, "b": {"c": base + 1, "d": base @ base.T, "e": mx.ones((3,))}}
+
+
+def test_chunked_eval_equals_one_shot_eval():
+    chunked = build()
+    utils.eval_parameters(chunked, chunk_bytes=1)
+    one_shot = build()
+    mx.eval(one_shot)
+    for (k1, v1), (k2, v2) in zip(tree_flatten(chunked), tree_flatten(one_shot)):
+        assert k1 == k2 and exact(v1, v2), k1
diff --git a/mlx_vlm/tests/test_a4_logits_to_keep.py b/mlx_vlm/tests/test_a4_logits_to_keep.py
new file mode 100644
index 0000000..583cdc5
--- /dev/null
+++ b/mlx_vlm/tests/test_a4_logits_to_keep.py
@@ -0,0 +1,81 @@
+"""A4: logits_to_keep on prefill/decode and the batched prompt path."""
+
+import mlx.core as mx
+import pytest
+
+from mlx_vlm.generate.ar import PromptProcessingBatch
+from mlx_vlm.tests._a4_common import close, exact, full_cache, old_model, run, tiny_model, tokens
+
+
+def test_logits_to_keep_rows_match_the_full_head_and_the_cache_is_untouched():
+    model = tiny_model()
+    ids = tokens(12)
+    full = model(ids, cache=model.make_cache()).logits
+    exactness = {}
+    for keep in (1, 3, 11):
+        out = model(ids, cache=model.make_cache(), logits_to_keep=keep)
+        assert out.logits.shape[1] == keep
+        # The head GEMM runs over ``keep`` rows instead of 12: same math, but
+        # the kernel may tile differently, so bit-equality is not promised.
+        close(out.logits, full[:, -keep:], atol=1e-6, rtol=1e-5)
+        exactness[keep] = exact(out.logits, full[:, -keep:])
+    print("sliced-head rows bit-exact vs full head:", exactness)
+    for keep in (None, 0, 12, 13, -1):
+        assert model(ids, cache=model.make_cache(), logits_to_keep=keep).logits.shape == full.shape
+    kept_cache, full_cache_ = model.make_cache(), model.make_cache()
+    model(ids, cache=kept_cache, logits_to_keep=1)
+    model(ids, cache=full_cache_)
+    nxt = tokens(1, seed=4)
+    assert exact(model(nxt, cache=kept_cache).logits, model(nxt, cache=full_cache_).logits)
+    # A one-token step is never sliced: bit-exact with and without the kwarg.
+    probe_a, probe_b = model.make_cache(), model.make_cache()
+    model(ids, cache=probe_a)
+    model(ids, cache=probe_b)
+    with_keep = model(nxt, cache=probe_a, logits_to_keep=1, return_hidden=True)
+    without = model(nxt, cache=probe_b, return_hidden=True)
+    assert with_keep.logits.shape == (1, 1, 60) and with_keep.hidden_states[-1].shape == (1, 1, 32)
+    assert exact(with_keep.logits, without.logits)
+
+
+@pytest.mark.parametrize("window", [8, 512])
+@pytest.mark.parametrize("chunk", [64, 513])
+def test_prompt_processing_batch_three_rows_match_138d761_single_rows(window, chunk):
+    model = tiny_model(window=window)
+    ref = old_model(model)
+    rows = [tokens(600, seed=3)[0].tolist(), tokens(591, seed=4)[0].tolist(), tokens(300, seed=5)[0].tolist()]
+    width = max(len(r) for r in rows)
+    right_pad = [width - len(r) for r in rows]
+    padded = [r + [0] * pad for r, pad in zip(rows, right_pad)]
+    steps = 30
+    batch = PromptProcessingBatch(
+        model=model,
+        uids=[0, 1, 2],
+        input_ids=rows,
+        max_tokens=[steps] * 3,
+        inputs_embeds=model.model.embed(mx.array(padded)),
+        prompt_kwargs={},
+        prefill_step_size=chunk,
+        right_pad_per_row=right_pad,
+        greedy_sampling=True,
+    )
+    while batch.needs_processing():
+        assert batch.prompt_step() > 0
+    gen = batch.generate(
+        sampler=lambda logits: mx.argmax(logits, axis=-1),
+        stop_criteria=lambda _: False,
+        compute_logprobs=False,
+    )
+    generated = {0: [], 1: [], 2: []}
+    while len(gen):
+        for response in gen.next():
+            generated[response.uid].append(int(response.token))
+    assert all(len(v) == steps for v in generated.values())
+    for uid, row in enumerate(rows):
+        ids = mx.array([row])
+        cache = full_cache(ref)
+        y = mx.argmax(run(ref, ids, cache, chunk)[:, -1], axis=-1)
+        want = []
+        for _ in range(steps):
+            want.append(int(y.item()))
+            y = mx.argmax(ref(y[:, None], cache=cache).logits[:, -1], axis=-1)
+        assert generated[uid] == want, uid
