index 0000000..bb9fe4f
--- /dev/null
+++ b/mlx_vlm/tests/test_a4_sconv_random.py
@@ -0,0 +1,78 @@
+"""A4: the strided short-conv decode kernel at random shapes and strides vs
+the 138d761 kernel (bit-exact) and the pure-MLX prefill path on the CPU."""
+
+import mlx.core as mx
+import numpy as np
+import pytest
+
+import mlx_vlm.models.inkling.language as lang
+import mlx_vlm.tests._a4_language_138d761 as old
+from mlx_vlm.tests._a4_common import exact
+
+metal = pytest.mark.skipif(
+    not (mx.default_device() == mx.gpu and mx.metal.is_available()), reason="Metal"
+)
+
+
+@metal
+@pytest.mark.parametrize("seed", range(16))
+def test_strided_kernel_bit_exact_vs_138d761_and_near_pure_mlx(seed):
+    rng = np.random.default_rng(seed)
+    dtype = [mx.float32, mx.bfloat16][seed % 2]
+    B = int(rng.integers(1, 4))
+    L = int(rng.integers(1, 9))
+    C = int(rng.choice([8, 32, 96, 1024]))
+    width = C + int(rng.integers(0, 64))
+    col = int(rng.integers(0, width - C + 1))
+    idx = int(rng.integers(0, 4))
+    mx.random.seed(seed)
+    weight = mx.random.normal((C, 1, 4)).transpose(0, 2, 1).astype(dtype)  # [C, K, 1] view
+    new = lang.InklingShortConvolution(C, 4, conv_idx=idx)
+    ref = old.InklingShortConvolution(C, 4, conv_idx=idx)
+    new.conv.weight = weight
+    ref.conv.weight = weight
+    fused = mx.random.normal((B, L, width)).astype(dtype)
+    x = fused[..., col : col + C]
+    kind = rng.integers(0, 3)
+    if kind == 0:
+        residual = None
+    elif kind == 1:
+        residual = mx.random.normal((B, L, C)).astype(dtype)
+    else:
+        residual = mx.random.normal((B, L, C + 7)).astype(dtype)[..., 3 : 3 + C]
+    if rng.random() < 0.3:
+        state = None
+    else:
+        # Strided fp32 view holding values of the stream dtype (as the model's
+        # state does: it stores the bf16 inputs losslessly in fp32).
+        state = mx.random.normal((B, 5, C)).astype(dtype).astype(mx.float32)[:, 1:4]
+    mx.eval(fused, weight, *(a for a in (residual, state) if a is not None))
+
+    new_cache, ref_cache = [None] * 4, [None] * 4
+    new_cache[idx] = state
+    ref_cache[idx] = state
+    out_new = new(x, cache=new_cache, residual=residual)
+    out_ref = ref(x, cache=ref_cache, residual=residual)
+    assert out_new.dtype == dtype and new_cache[idx].dtype == mx.float32
+    assert exact(out_new, out_ref), (B, L, C, col, kind)
+    assert exact(new_cache[idx], ref_cache[idx])
+    assert new_cache[idx].shape == (B, 3, C)
+
+    pure = lang.InklingShortConvolution(C, 4, conv_idx=idx)
+    pure.conv.weight = weight
+    pure_cache = [None] * 4
+    pure_cache[idx] = None if state is None else mx.contiguous(state)
+    with mx.stream(mx.cpu):
+        out_pure = pure(
+            mx.contiguous(x),
+            cache=pure_cache,
+            residual=None if residual is None else mx.contiguous(residual),
+        )
+        mx.eval(out_pure, pure_cache[idx])
+    assert exact(new_cache[idx], pure_cache[idx])
+    np.testing.assert_allclose(
+        np.array(out_new.astype(mx.float32)),
+        np.array(out_pure.astype(mx.float32)),
+        rtol=1e-6 if dtype == mx.float32 else 1e-2,
+        atol=1e-6 if dtype == mx.float32 else 2e-2,
+    )
diff --git a/mlx_vlm/tests/test_a4_window_cache.py b/mlx_vlm/tests/test_a4_window_cache.py
new file mode 100644
index 0000000..9126e93
--- /dev/null
+++ b/mlx_vlm/tests/test_a4_window_cache.py
@@ -0,0 +1,254 @@
+"""A4: the bounded window caches against the 138d761 implementation.
+
+The reference is the released code (unbounded KVCache per layer) running the
+same weights; the branch must reproduce its logits bit for bit on prefill
+chunks of 1/7/64/512/513 tokens and on decode, hold the window-coverage
+invariant at the cache level under random schedules, and round-trip its
+snapshots.
+"""
+
+import mlx.core as mx
+import numpy as np
+import pytest
+
+from mlx_vlm.generate import dispatch
+from mlx_vlm.generate.ar import _make_cache
+from mlx_vlm.models.cache import BatchSlidingWindowKVCache, KVCache, SlidingWindowKVCache
+from mlx_vlm.tests._a4_common import (
+    close,
+    exact,
+    full_cache,
+    max_abs_diff,
+    old_model,
+    run,
+    tiny_model,
+    tokens,
+)
+
+CHUNKS = [1, 7, 64, 512, 513]
+
+
+@pytest.mark.parametrize("window", [8, 512])
+@pytest.mark.parametrize("chunk", CHUNKS)
+def test_bit_exact_vs_138d761_prefill_and_decode(window, chunk):
+    model = tiny_model(window=window)
+    ref = old_model(model)
+    ids = tokens(600)
+    bounded, full = model.make_cache(), full_cache(ref)
+    got = run(model, ids, bounded, chunk)
+    want = run(ref, ids, full, chunk)
+    assert exact(got, want), f"prefill differs by {max_abs_diff(got, want):.3e}"
+    y = mx.argmax(got[:, -1], axis=-1)
+    for step in range(200):
+        g = model(y[:, None], cache=bounded).logits
+        w = ref(y[:, None], cache=full).logits
+        assert exact(g, w), f"decode step {step} differs by {max_abs_diff(g, w):.3e}"
+        y = mx.argmax(g[:, -1], axis=-1)
+    for layer, c in zip(model.layers, bounded):
+        kv = c.caches[0]
+        if layer.self_attn.sliding:
+            assert isinstance(kv, SlidingWindowKVCache)
+            assert kv.offset == 800
+            assert kv.keys.shape[2] <= kv._capacity_for(window + max(kv.buffer_size, chunk))
+        else:
+            assert type(kv) is KVCache and kv.offset == 800
+
