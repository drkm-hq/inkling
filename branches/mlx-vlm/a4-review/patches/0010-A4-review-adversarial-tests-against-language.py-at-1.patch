+def test_snapshot_round_trips_mid_window_at_model_level():
+    """from_state and prefix_cache_snapshot/restore of a compacted window cache
+    must continue bit-exactly (the APC adapters use both)."""
+    from mlx_vlm.models.cache import ArraysCache
+
+    model = tiny_model(window=8)
+    cache = model.make_cache()
+    model(tokens(600), cache=cache)
+    y = tokens(1, seed=2)
+    for _ in range(270):
+        y = mx.argmax(model(y, cache=cache).logits[:, -1], axis=-1)[:, None]
+    assert all(c.caches[0].start_position > 0 for c in cache if isinstance(c.caches[0], SlidingWindowKVCache))
+
+    def clone_conv(conv):
+        c = ArraysCache(len(conv.cache))
+        c.state = [None if a is None else mx.array(a) for a in conv.state]
+        return c
+
+    via_state = [
+        type(c)(
+            type(c.caches[0]).from_state(
+                [mx.array(a) for a in c.caches[0].state], c.caches[0].meta_state
+            ),
+            clone_conv(c.caches[1]),
+        )
+        for c in cache
+    ]
+    via_prefix = model.make_cache()
+    for fresh, c in zip(via_prefix, cache):
+        snap = c.caches[0].prefix_cache_snapshot()
+        snap = {"state": tuple(mx.array(a) for a in snap["state"]), "meta_state": snap["meta_state"]}
+        fresh.caches[0].prefix_cache_restore(snap)
+        fresh.caches[1].state = clone_conv(c.caches[1]).state
+    want = model(y, cache=cache).logits
+    for name, probe in (("from_state", via_state), ("prefix_cache_restore", via_prefix)):
+        got = model(y, cache=probe).logits
+        assert exact(got, want), f"{name}: {max_abs_diff(got, want):.3e}"
+        assert [c.caches[0].offset for c in probe] == [c.caches[0].offset for c in cache]
