+"""Shared helpers for the A4 review tests.
+
+``old`` is mlx_vlm/models/inkling/language.py at 138d761 (= the 0.7.11 wheel),
+so every comparison here is branch vs released code with identical weights.
+The 138d761 route kernel needs a router row of >= 32 bytes (that is what
+K4's commit 3 fixed), so the tiny configs use 16 routed experts.
+"""
+
+import mlx.core as mx
+import numpy as np
+from mlx.utils import tree_flatten, tree_map
+
+import mlx_vlm.models.inkling.language as lang
+import mlx_vlm.tests._a4_language_138d761 as old
+from mlx_vlm.models.cache import ArraysCache, CacheList, KVCache
+from mlx_vlm.models.inkling.config import TextConfig
+
+VOCAB = 64
+
+
+def tiny_config(window=8, **overrides):
+    config = dict(
+        hidden_size=32,
+        num_hidden_layers=3,
+        vocab_size=VOCAB,
+        unpadded_vocab_size=VOCAB - 4,
+        num_attention_heads=4,
+        num_key_value_heads=2,
+        head_dim=8,
+        swa_num_attention_heads=4,
+        swa_num_key_value_heads=2,
+        swa_head_dim=8,
+        sliding_window_size=window,
+        layer_types=["hybrid_sliding", "hybrid", "hybrid_sliding"],
+        d_rel=4,
+        rel_extent=16,
+        log_scaling_n_floor=4096,
+        sconv_kernel_size=4,
+        mlp_layer_types=["dense", "moe", "dense"],
+        intermediate_size=16,
+        dense_intermediate_size=64,
+        n_routed_experts=16,
+        num_experts_per_tok=2,
+        n_shared_experts=1,
+        logits_mup_width_multiplier=16.0,
+    )
+    config.update(overrides)
+    return TextConfig(**config)
+
+
+def randomize(module, seed, scale=0.5):
+    """Give every parameter (including zero-initialised ones) random values."""
+    mx.random.seed(seed)
+    params = tree_map(
+        lambda v: (mx.random.normal(v.shape) * scale).astype(v.dtype),
+        module.parameters(),
+    )
+    module.update(params)
+    mx.eval(module.parameters())
+    return module
+
+
+def tiny_model(window=8, seed=0, dtype=mx.float32, **overrides):
+    model = lang.LanguageModel(tiny_config(window, **overrides))
+    mx.random.seed(seed)
+    randomized = {
+        k: mx.random.normal(v.shape) * 0.5
+        for k, v in tree_flatten(model.parameters())
+        if not mx.any(v).item()
+    }
+    model.load_weights(list(randomized.items()), strict=False)
+    if dtype != mx.float32:
+        model.set_dtype(dtype)
+    model.eval()
+    mx.eval(model.parameters())
+    return model
+
+
+def old_model(new):
+    """The 138d761 LanguageModel carrying exactly the branch model's weights."""
+    ref = old.LanguageModel(new.config)
+    ref.update(new.parameters())
+    ref.eval()
+    mx.eval(ref.parameters())
+    return ref
+
+
+def full_cache(model):
+    """The 138d761 cache layout: an unbounded KVCache for every layer."""
+    return [CacheList(KVCache(), ArraysCache(4)) for _ in model.layers]
+
+
+def tokens(n, seed=1, batch=1):
+    mx.random.seed(seed)
+    return mx.random.randint(0, VOCAB - 4, (batch, n))
+
+
+def run(model, ids, cache, chunk):
+    outs = []
+    for start in range(0, ids.shape[1], chunk):
+        outs.append(model(ids[:, start : start + chunk], cache=cache).logits)
+    return mx.concatenate(outs, axis=1)
+
+
+def close(a, b, atol=1e-5, rtol=1e-5):
+    np.testing.assert_allclose(
+        np.array(a.astype(mx.float32)), np.array(b.astype(mx.float32)), atol=atol, rtol=rtol
+    )
+
+
+def exact(a, b):
+    return bool(mx.array_equal(a, b).item())
+
+
+def max_abs_diff(a, b):
+    return float(mx.max(mx.abs(a.astype(mx.float32) - b.astype(mx.float32))).item())
