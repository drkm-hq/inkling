index 0000000..4c44acb
--- /dev/null
+++ b/mlx_vlm/tests/test_inkling_fast_path.py
@@ -0,0 +1,224 @@
+"""Inkling decode fast path: bounded window caches and the attention around them.
+
+Every test compares against the straightforward implementation (an unbounded
+KVCache per layer, the mask built from all keys), so the bounded caches have
+to reproduce it exactly: same logits, same masks, same rollback behaviour,
+and the same per-row results under batching.
+"""
+
+import mlx.core as mx
+import mlx.nn as nn
+import numpy as np
+import pytest
+from mlx.utils import tree_flatten
+
+import mlx_vlm.models.inkling.language as lang
+from mlx_vlm.generate.ar import _make_cache
+from mlx_vlm.models.cache import (
+    ArraysCache,
+    BatchSlidingWindowKVCache,
+    CacheList,
+    KVCache,
+    SlidingWindowKVCache,
+)
+from mlx_vlm.models.inkling.config import TextConfig
+from mlx_vlm.models.inkling.language import LanguageModel
+
+VOCAB = 64
+
+
+def tiny_config(window=8, **overrides):
+    config = dict(
+        hidden_size=32,
+        num_hidden_layers=3,
+        vocab_size=VOCAB,
+        unpadded_vocab_size=VOCAB - 4,
+        num_attention_heads=4,
+        num_key_value_heads=2,
+        head_dim=8,
+        swa_num_attention_heads=4,
+        swa_num_key_value_heads=2,
+        swa_head_dim=8,
+        sliding_window_size=window,
+        layer_types=["hybrid_sliding", "hybrid", "hybrid_sliding"],
+        d_rel=4,
+        rel_extent=16,
+        log_scaling_n_floor=4096,
+        sconv_kernel_size=4,
+        mlp_layer_types=["dense", "moe", "dense"],
+        intermediate_size=16,
+        dense_intermediate_size=64,
+        n_routed_experts=4,
+        num_experts_per_tok=2,
+        n_shared_experts=1,
+        logits_mup_width_multiplier=16.0,
+    )
+    config.update(overrides)
+    return TextConfig(**config)
+
+
+def tiny_model(window=8, seed=0, **overrides):
+    mx.random.seed(seed)
+    model = LanguageModel(tiny_config(window, **overrides))
+    # Zero-initialized parameters (relative projection, router) need values.
+    randomized = {
+        k: mx.random.normal(v.shape) * 0.5
+        for k, v in tree_flatten(model.parameters())
+        if not mx.any(v).item()
+    }
+    model.load_weights(list(randomized.items()), strict=False)
+    model.eval()
+    mx.eval(model.parameters())
+    return model
+
+
+def full_cache(model):
+    """The cache layout before bounded windows: everything is kept."""
+    return [CacheList(KVCache(), ArraysCache(4)) for _ in model.layers]
+
+
+def tokens(n, seed=1, batch=1):
+    mx.random.seed(seed)
+    return mx.random.randint(0, VOCAB - 4, (batch, n))
+
+
+def run(model, ids, cache, chunk):
+    outs = []
+    for start in range(0, ids.shape[1], chunk):
+        outs.append(model(ids[:, start : start + chunk], cache=cache).logits)
+    return mx.concatenate(outs, axis=1)
+
+
+def close(a, b, atol=1e-5):
+    np.testing.assert_allclose(np.array(a), np.array(b), atol=atol, rtol=1e-5)
+
+
+def test_make_cache_bounds_only_the_sliding_layers():
+    model = tiny_model(window=8)
+    caches = model.make_cache()
+    kinds = [type(c.caches[0]) for c in caches]
+    assert kinds == [SlidingWindowKVCache, KVCache, SlidingWindowKVCache]
+    assert all(isinstance(c.caches[1], ArraysCache) for c in caches)
+    assert caches[0].caches[0].max_size == 8
+
+
+@pytest.mark.parametrize("window,chunk", [(8, 157), (512, 157), (512, 600)])
+def test_window_cache_matches_full_cache(window, chunk):
+    model = tiny_model(window=window)
+    ids = tokens(600)
+    bounded, reference = model.make_cache(), full_cache(model)
+    close(run(model, ids, bounded, chunk), run(model, ids, reference, chunk))
+    for layer, c in zip(model.layers, bounded):
+        kv = c.caches[0]
+        if layer.self_attn.sliding:
+            assert kv.offset == 600
+            assert kv._idx <= window - 1 + max(kv.buffer_size, chunk)
+            assert kv.keys.shape[2] <= kv._capacity_for(
+                window + max(kv.buffer_size, chunk)
+            )
+        else:
+            assert kv.offset == 600 and kv.keys.shape[2] >= 600
+
+    # Greedy decode steps: the bounded caches must give the same next token
+    # and the same logits as the unbounded ones, past several compactions.
+    y = mx.argmax(model(ids[:, -1:], cache=bounded).logits[:, -1], axis=-1)
+    model(ids[:, -1:], cache=reference)
+    for _ in range(300 if window == 8 else 200):
+        got = model(y[:, None], cache=bounded).logits
+        want = model(y[:, None], cache=reference).logits
+        close(got, want)
+        y = mx.argmax(got[:, -1], axis=-1)
+    for layer, c in zip(model.layers, bounded):
+        kv = c.caches[0]
+        if layer.self_attn.sliding:
+            assert kv.offset == reference[0].caches[0].offset
+            assert kv._idx <= window + kv.buffer_size
+            assert kv.start_position > 0
+
+
+def test_window_mask_indexes_the_bias_by_distance(monkeypatch):
+    """The additive mask on a bounded cache equals the one built on all keys and
+    the closed form: bias[j] = r . proj[:, dist] with dist = (S - 1) - j."""
+    model = tiny_model(window=8)
+    masks = []
+    real = lang.banded_additive_mask
+
+    def spy(*args, **kwargs):
+        mask = real(*args, **kwargs)
+        masks.append((args[0], args[1], kwargs.get("shape_ref"), mask))
+        return mask
+
+    monkeypatch.setattr(lang, "banded_additive_mask", spy)
+    ids = tokens(40)
+    bounded, reference = model.make_cache(), full_cache(model)
+    model(ids, cache=bounded)
+    model(ids, cache=reference)
+    for step in range(12):
+        tok = ids[:, step : step + 1]
+        del masks[:]
+        model(tok, cache=bounded)
+        bounded_masks = list(masks)
+        del masks[:]
+        model(tok, cache=reference)
+        for (rel, proj, k_b, m_b), (_, _, k_r, m_r) in zip(bounded_masks, masks):
+            assert m_b.shape == m_r.shape
+            close(m_b, m_r)
+            S = m_b.shape[-1]
+            assert k_b.shape[2] == S
+            dist = (S - 1) - mx.arange(S)
+            bias = (rel @ proj)[0, 0]  # [H, extent]
+            idx = mx.clip(dist, 0, proj.shape[1] - 1)[None]
+            expected = mx.take_along_axis(
+                bias, mx.broadcast_to(idx, (bias.shape[0], S)), axis=-1
+            )
+            sliding = m_b.shape[-1] <= 8
+            if sliding:
+                assert S == 8
+                close(m_b[0, :, 0], expected)
+            else:
+                outside = dist >= proj.shape[1]
+                close(mx.where(outside[None], 0.0, expected), m_b[0, :, 0])
+
+
+def test_window_cache_rollback_matches_replay():
+    model = tiny_model(window=8)
+    ids = tokens(600)
+    cache = model.make_cache()
+    model(ids, cache=cache)
+    verify = tokens(4, seed=7)
+    hidden, _, state = model.speculative_verify_hidden(verify, cache)
+    assert hidden.shape == (1, 4, 32)
+    offsets = [c.caches[0].offset for c in cache]
+    assert offsets == [604, 604, 604]
+    accepted = model.rollback_speculative_cache(cache, state, 1, 4)
+    assert accepted == 1
+    assert [c.caches[0].offset for c in cache] == [602, 602, 602]
+    reference = full_cache(model)
+    model(mx.concatenate([ids, verify[:, :2]], axis=1), cache=reference)
+    nxt = tokens(1, seed=9)
+    close(model(nxt, cache=cache).logits, model(nxt, cache=reference).logits)
+
+
+def test_batched_window_cache_matches_single_rows():
+    model = tiny_model(window=8)
+    rows = [tokens(600, seed=3), tokens(591, seed=4)]
+    pad = 600 - 591
+    batch_ids = mx.concatenate(
+        [rows[0], mx.concatenate([mx.zeros((1, pad), mx.int32), rows[1]], axis=1)]
+    )
+    cache = _make_cache(model, left_padding=[0, pad])
+    assert isinstance(cache[0].caches[0], BatchSlidingWindowKVCache)
+    assert cache[0].caches[1].left_padding.tolist() == [0, pad]
+    batched = run(model, batch_ids, cache, 157)
+    singles = [model.make_cache() for _ in rows]
+    for row, (ids, single) in enumerate(zip(rows, singles)):
+        logits = run(model, ids, single, 157)
+        close(batched[row : row + 1, pad * row :], logits)
+    y = batch_ids[:, -1:]
+    for _ in range(40):
+        got = model(y, cache=cache).logits
+        for row, single in enumerate(singles):
+            close(got[row : row + 1], model(y[row : row + 1], cache=single).logits)
+        y = mx.argmax(got[:, -1], axis=-1)[:, None]
+    assert cache[0].caches[0].start_position > 0
+    assert cache[0].caches[0].keys.shape[2] <= 1024
