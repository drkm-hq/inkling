+class SlidingWindowKVCache(BufferedRotatingKVCache):
+    """Bounded KV cache for a sliding-window layer whose attention is formed
+    by the model itself (a distance-based bias, a model-built mask).
+
+    Keys stay in temporal order: ``update_and_fetch`` returns the newest
+    positions as one ``[B, H, n, D]`` view, and once the window is full
+    ``max_size - 1 <= n - L <= max_size - 1 + buffer_size`` for an update of
+    ``L`` tokens, so the last query sees exactly its window plus a bounded
+    slack the caller may slice off. ``RotatingKVCache`` returns its ring out
+    of order at decode, which a bias indexed by distance cannot use; this
+    cache compacts in place every ``buffer_size`` tokens instead. It is
+    trimmable for speculative rollback, its snapshot round-trips through
+    ``state``/``meta_state``, and ``to_batch``/``merge`` keep the layout for
+    continuous batching.
+    """
+
+    def __init__(self, max_size: int, buffer_size: int = 256):
+        super().__init__(max_size=max_size, keep=0, buffer_size=buffer_size)
+
+    def update_and_fetch(self, keys: mx.array, values: mx.array):
+        incoming = int(keys.shape[2])
+        drop = self._planned_drop(incoming)
+        keep = self._idx - drop
+        needed = keep + incoming
+        if self.keys is None or drop > 0 or needed > self.keys.shape[2]:
+            # One allocation covers both compaction and growth.
+            if self.keys is not None and needed <= self.keys.shape[2]:
+                capacity = self.keys.shape[2]
+            else:
+                capacity = self._capacity_for(needed)
+            new_keys = mx.zeros(
+                (*keys.shape[:2], capacity, keys.shape[-1]), dtype=keys.dtype
+            )
+            new_values = mx.zeros(
+                (*values.shape[:2], capacity, values.shape[-1]), dtype=values.dtype
+            )
+            if keep > 0:
+                new_keys[..., :keep, :] = self.keys[..., drop : self._idx, :]
+                new_values[..., :keep, :] = self.values[..., drop : self._idx, :]
+            self.keys, self.values = new_keys, new_values
+            self.start_position += drop
+            self._idx = keep
+        self.keys[..., self._idx : needed, :] = keys
+        self.values[..., self._idx : needed, :] = values
+        self._idx = needed
+        self.offset += incoming
+        return self.keys[..., : self._idx, :], self.values[..., : self._idx, :]
+
+    def to_batch(self, left_padding: List[int]):
+        return BatchSlidingWindowKVCache(
+            self.max_size, left_padding, buffer_size=self.buffer_size
+        )
+
+    @classmethod
+    def merge(cls, caches):
+        return BatchSlidingWindowKVCache.merge(caches)
+
+    def prefix_cache_merge(self, rows, prefix_lens):
+        if not rows or len(rows) != len(prefix_lens):
+            return None
+        for row, length in zip(rows, prefix_lens):
+            if not isinstance(row, SlidingWindowKVCache):
+                return None
+            if row.max_size != self.max_size:
+                return None
+            if row.keys is not None and int(row.offset) != int(length):
+                return None
+        return self.merge(rows)
+
+
+class BatchSlidingWindowKVCache(BatchKVCache):
+    """Batched, left-padded form of ``SlidingWindowKVCache``.
+
+    Rows share one column timeline (``BatchKVCache`` layout); the cache is
+    compacted by dropping the leading columns no row can see any more, which
+    shifts ``left_padding`` with them (a negative value means the padding was
+    evicted). Compaction waits while right padding is pending, so
+    ``finalize`` can roll the padded rows into place first.
+    """
+
+    memory_profile = _windowed_memory_profile
+
+    def __init__(self, max_size: int, left_padding: List[int], buffer_size: int = 256):
+        super().__init__(left_padding)
+        self.max_size = int(max_size)
+        self.buffer_size = max(0, int(buffer_size))
+        self.start_position = 0
+
+    def _planned_drop(self, incoming: int) -> int:
+        if self._right_padding is not None:
+            return 0
+        if self._idx + incoming <= self.max_size + max(self.buffer_size, incoming):
+            return 0
+        return max(0, self._idx - (self.max_size - 1))
+
+    def update_and_fetch(self, keys: mx.array, values: mx.array):
+        drop = self._planned_drop(int(keys.shape[2]))
+        if drop > 0:
+            keep = self._idx - drop
+            capacity = self.keys.shape[2]
+            new_keys = mx.zeros(
+                (*self.keys.shape[:2], capacity, self.keys.shape[-1]),
+                dtype=self.keys.dtype,
+            )
+            new_values = mx.zeros(
+                (*self.values.shape[:2], capacity, self.values.shape[-1]),
+                dtype=self.values.dtype,
+            )
+            if keep > 0:
+                new_keys[..., :keep, :] = self.keys[..., drop : self._idx, :]
+                new_values[..., :keep, :] = self.values[..., drop : self._idx, :]
+            self.keys, self.values = new_keys, new_values
+            self.left_padding = self.left_padding - drop
+            self.start_position += drop
+            self._idx = keep
+        return super().update_and_fetch(keys, values)
+
+    @property
+    def meta_state(self):
+        return tuple(map(str, (self.max_size, self.buffer_size, self.start_position)))
+
+    @meta_state.setter
+    def meta_state(self, v):
+        self.max_size, self.buffer_size, self.start_position = map(int, v)
+
+    def extend(self, other):
+        if other.max_size != self.max_size:
+            raise ValueError(
+                "BatchSlidingWindowKVCache can only extend caches with the same "
+                "window size"
+            )
+        super().extend(other)
+        self.start_position = max(self.start_position, other.start_position)
+
+    def extract(self, idx):
+        cache = SlidingWindowKVCache(self.max_size, buffer_size=self.buffer_size)
+        if self.keys is None:
+            return cache
+        padding = max(0, int(self.left_padding[idx].item()))
+        cache.keys = mx.contiguous(self.keys[idx : idx + 1, :, padding : self._idx])
+        cache.values = mx.contiguous(self.values[idx : idx + 1, :, padding : self._idx])
+        cache.offset = int(self.offset[idx].item())
+        cache._idx = cache.keys.shape[2]
+        cache.start_position = max(0, cache.offset - cache._idx)
+        return cache
+
+    @classmethod
+    def merge(cls, caches):
+        max_size = caches[0].max_size
+        if not all(c.max_size == max_size for c in caches):
+            raise ValueError(
+                "BatchSlidingWindowKVCache can only merge caches with the same "
+                "window size"
+            )
+        buffer_size = max(c.buffer_size for c in caches)
+        states = [(None, None) if c.keys is None else c.state for c in caches]
+        lengths = [0 if k is None else int(k.shape[2]) for k, _ in states]
+        max_length = max(lengths)
+        if max_length == 0:
+            return cls(max_size, [0] * len(caches), buffer_size=buffer_size)
+
+        padding = [max_length - length for length in lengths]
+        B = len(caches)
+        H = max(k.shape[1] for k, _ in states if k is not None)
+        Dk = max(k.shape[3] for k, _ in states if k is not None)
+        Dv = max(v.shape[3] for _, v in states if v is not None)
+        dt = next(iter(k.dtype for k, _ in states if k is not None))
+
+        keys = mx.zeros((B, H, max_length, Dk), dtype=dt)
+        values = mx.zeros((B, H, max_length, Dv), dtype=dt)
+        for i, (p, length, (k, v)) in enumerate(zip(padding, lengths, states)):
+            if k is None:
+                continue
+            keys[i : i + 1, :, p : p + length] = k
+            values[i : i + 1, :, p : p + length] = v
+
+        cache = cls(max_size, padding, buffer_size=buffer_size)
+        cache.keys = keys
+        cache.values = values
+        cache.offset = mx.array([int(c.offset) for c in caches])
+        cache._idx = max_length
+        cache.start_position = max(int(c.start_position) for c in caches)
+        return cache
+
+
 class BatchQuantizedKVCache(_BaseCache):
     """Batch-aware quantized KV cache for continuous batching.
 
