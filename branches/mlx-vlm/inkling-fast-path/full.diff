+        # the last ``sliding_window_size - 1`` keys plus a slack buffer in
+        # temporal order; global layers keep everything.
+        return [
+            InklingCacheList(
+                (
+                    SlidingWindowKVCache(layer.self_attn.sliding)
+                    if layer.self_attn.sliding > 0
+                    else KVCache()
+                ),
+                ArraysCache(4),
+            )
+            for layer in self.model.layers
+        ]
