--- /dev/null
+++ b/mlx_vlm/tests/test_inkling_fast_path.py
@@ -0,0 +1,546 @@
+"""Inkling decode fast path: bounded window caches and the attention around them.
+
+Every test compares against the straightforward implementation (an unbounded
+KVCache per layer, the mask built from all keys), so the bounded caches have
+to reproduce it exactly: same logits, same masks, same rollback behaviour,
+and the same per-row results under batching.
+"""
+
+import mlx.core as mx
+import numpy as np
+import pytest
+from mlx.utils import tree_flatten
+
+import mlx_vlm.models.inkling.language as lang
+from mlx_vlm.generate.ar import _make_cache
+from mlx_vlm.models.cache import (
+    ArraysCache,
+    BatchSlidingWindowKVCache,
+    CacheList,
+    KVCache,
+    SlidingWindowKVCache,
+)
+from mlx_vlm.models.inkling.config import TextConfig
+from mlx_vlm.models.inkling.language import LanguageModel
+
+VOCAB = 64
+
+
+def tiny_config(window=8, **overrides):
+    config = dict(
+        hidden_size=32,
+        num_hidden_layers=3,
+        vocab_size=VOCAB,
+        unpadded_vocab_size=VOCAB - 4,
+        num_attention_heads=4,
+        num_key_value_heads=2,
+        head_dim=8,
+        swa_num_attention_heads=4,
+        swa_num_key_value_heads=2,
+        swa_head_dim=8,
+        sliding_window_size=window,
+        layer_types=["hybrid_sliding", "hybrid", "hybrid_sliding"],
+        d_rel=4,
+        rel_extent=16,
+        log_scaling_n_floor=4096,
+        sconv_kernel_size=4,
+        mlp_layer_types=["dense", "moe", "dense"],
+        intermediate_size=16,
+        dense_intermediate_size=64,
+        n_routed_experts=4,
+        num_experts_per_tok=2,
+        n_shared_experts=1,
+        logits_mup_width_multiplier=16.0,
+    )
+    config.update(overrides)
+    return TextConfig(**config)
+
+
+def tiny_model(window=8, seed=0, **overrides):
+    mx.random.seed(seed)
+    model = LanguageModel(tiny_config(window, **overrides))
+    # Zero-initialized parameters (relative projection, router) need values.
+    randomized = {
+        k: mx.random.normal(v.shape) * 0.5
+        for k, v in tree_flatten(model.parameters())
+        if not mx.any(v).item()
+    }
+    model.load_weights(list(randomized.items()), strict=False)
+    model.eval()
+    mx.eval(model.parameters())
+    return model
+
+
+def full_cache(model):
+    """The cache layout before bounded windows: everything is kept."""
+    return [CacheList(KVCache(), ArraysCache(4)) for _ in model.layers]
+
+
+def tokens(n, seed=1, batch=1):
+    mx.random.seed(seed)
+    return mx.random.randint(0, VOCAB - 4, (batch, n))
+
+
+def run(model, ids, cache, chunk):
+    outs = []
+    for start in range(0, ids.shape[1], chunk):
+        outs.append(model(ids[:, start : start + chunk], cache=cache).logits)
+    return mx.concatenate(outs, axis=1)
+
+
+def close(a, b, atol=1e-5):
+    np.testing.assert_allclose(np.array(a), np.array(b), atol=atol, rtol=1e-5)
+
+
+def test_make_cache_bounds_only_the_sliding_layers():
+    model = tiny_model(window=8)
+    caches = model.make_cache()
+    kinds = [type(c.caches[0]) for c in caches]
+    assert kinds == [SlidingWindowKVCache, KVCache, SlidingWindowKVCache]
+    assert all(isinstance(c.caches[1], ArraysCache) for c in caches)
+    assert caches[0].caches[0].max_size == 8
+
+
+@pytest.mark.parametrize("window,chunk", [(8, 157), (512, 157), (512, 600)])
+def test_window_cache_matches_full_cache(window, chunk):
+    model = tiny_model(window=window)
+    ids = tokens(600)
+    bounded, reference = model.make_cache(), full_cache(model)
+    close(run(model, ids, bounded, chunk), run(model, ids, reference, chunk))
+    for layer, c in zip(model.layers, bounded):
+        kv = c.caches[0]
+        if layer.self_attn.sliding:
+            assert kv.offset == 600
+            assert kv._idx <= window - 1 + max(kv.buffer_size, chunk)
+            assert kv.keys.shape[2] <= kv._capacity_for(
+                window + max(kv.buffer_size, chunk)
+            )
+        else:
+            assert kv.offset == 600 and kv.keys.shape[2] >= 600
+
+    # Greedy decode steps: the bounded caches must give the same next token
+    # and the same logits as the unbounded ones, past several compactions.
+    y = mx.argmax(model(ids[:, -1:], cache=bounded).logits[:, -1], axis=-1)
+    model(ids[:, -1:], cache=reference)
+    for _ in range(300 if window == 8 else 200):
+        got = model(y[:, None], cache=bounded).logits
+        want = model(y[:, None], cache=reference).logits
+        close(got, want)
+        y = mx.argmax(got[:, -1], axis=-1)
+    for layer, c in zip(model.layers, bounded):
+        kv = c.caches[0]
+        if layer.self_attn.sliding:
+            assert kv.offset == reference[0].caches[0].offset
+            assert kv._idx <= window + kv.buffer_size
+            assert kv.start_position > 0
+
+
+def test_window_mask_indexes_the_bias_by_distance(monkeypatch):
+    """The additive mask on a bounded cache equals the one built on all keys and
+    the closed form: bias[j] = r . proj[:, dist] with dist = (S - 1) - j."""
+    model = tiny_model(window=8)
+    masks = []
+    real = lang.banded_additive_mask
+
+    def spy(*args, **kwargs):
+        mask = real(*args, **kwargs)
+        masks.append((args[0], args[1], kwargs.get("shape_ref"), mask))
+        return mask
+
+    monkeypatch.setattr(lang, "banded_additive_mask", spy)
+    ids = tokens(40)
+    bounded, reference = model.make_cache(), full_cache(model)
+    model(ids, cache=bounded)
+    model(ids, cache=reference)
+    for step in range(12):
+        tok = ids[:, step : step + 1]
+        del masks[:]
+        model(tok, cache=bounded)
+        bounded_masks = list(masks)
+        del masks[:]
+        model(tok, cache=reference)
+        for (rel, proj, k_b, m_b), (_, _, k_r, m_r) in zip(bounded_masks, masks):
+            assert m_b.shape == m_r.shape
+            close(m_b, m_r)
+            S = m_b.shape[-1]
+            assert k_b.shape[2] == S
+            dist = (S - 1) - mx.arange(S)
+            bias = (rel @ proj)[0, 0]  # [H, extent]
+            idx = mx.clip(dist, 0, proj.shape[1] - 1)[None]
+            expected = mx.take_along_axis(
+                bias, mx.broadcast_to(idx, (bias.shape[0], S)), axis=-1
+            )
+            sliding = m_b.shape[-1] <= 8
+            if sliding:
+                assert S == 8
+                close(m_b[0, :, 0], expected)
+            else:
+                outside = dist >= proj.shape[1]
+                close(mx.where(outside[None], 0.0, expected), m_b[0, :, 0])
+
+
+def test_window_cache_rollback_matches_replay():
+    model = tiny_model(window=8)
+    ids = tokens(600)
+    cache = model.make_cache()
+    model(ids, cache=cache)
+    verify = tokens(4, seed=7)
+    hidden, _, state = model.speculative_verify_hidden(verify, cache)
+    assert hidden.shape == (1, 4, 32)
+    offsets = [c.caches[0].offset for c in cache]
+    assert offsets == [604, 604, 604]
+    accepted = model.rollback_speculative_cache(cache, state, 1, 4)
+    assert accepted == 1
+    assert [c.caches[0].offset for c in cache] == [602, 602, 602]
+    reference = full_cache(model)
+    model(mx.concatenate([ids, verify[:, :2]], axis=1), cache=reference)
+    nxt = tokens(1, seed=9)
+    close(model(nxt, cache=cache).logits, model(nxt, cache=reference).logits)
+
+
+def test_batched_window_cache_matches_single_rows():
+    model = tiny_model(window=8)
+    rows = [tokens(600, seed=3), tokens(591, seed=4)]
+    pad = 600 - 591
+    batch_ids = mx.concatenate(
+        [rows[0], mx.concatenate([mx.zeros((1, pad), mx.int32), rows[1]], axis=1)]
+    )
+    cache = _make_cache(model, left_padding=[0, pad])
+    assert isinstance(cache[0].caches[0], BatchSlidingWindowKVCache)
+    assert cache[0].caches[1].left_padding.tolist() == [0, pad]
+    batched = run(model, batch_ids, cache, 157)
+    singles = [model.make_cache() for _ in rows]
+    for row, (ids, single) in enumerate(zip(rows, singles)):
+        logits = run(model, ids, single, 157)
+        close(batched[row : row + 1, pad * row :], logits)
+    y = batch_ids[:, -1:]
+    for _ in range(40):
+        got = model(y, cache=cache).logits
+        for row, single in enumerate(singles):
+            close(got[row : row + 1], model(y[row : row + 1], cache=single).logits)
+        y = mx.argmax(got[:, -1], axis=-1)[:, None]
+    assert cache[0].caches[0].start_position > 0
+    assert cache[0].caches[0].keys.shape[2] <= 1024
+
+
+# --------------------------------------------- continuous batching end to end
+
+
+def test_prompt_processing_batch_matches_single_rows():
+    """The batch generator path: right-padded prompts, chunked prefill through
+    PromptProcessingBatch, then GenerationBatch decode on the batched window
+    caches, must produce each row's single-sequence greedy tokens."""
+    from mlx_vlm.generate.ar import PromptProcessingBatch
+
+    model = tiny_model(window=8)
+    rows = [tokens(600, seed=3)[0].tolist(), tokens(591, seed=4)[0].tolist()]
+    width = max(len(r) for r in rows)
+    right_pad = [width - len(r) for r in rows]
+    padded = [r + [0] * pad for r, pad in zip(rows, right_pad)]
+    steps = 30
+    batch = PromptProcessingBatch(
+        model=model,
+        uids=[0, 1],
+        input_ids=rows,  # unpadded ids: their lengths mark where rows end
+        max_tokens=[steps, steps],
+        inputs_embeds=model.model.embed(mx.array(padded)),
+        prompt_kwargs={},
+        prefill_step_size=157,
+        right_pad_per_row=right_pad,
+        greedy_sampling=True,
+    )
+    while batch.needs_processing():
+        assert batch.prompt_step() > 0
+    assert isinstance(batch.prompt_cache[0].caches[0], BatchSlidingWindowKVCache)
+    gen = batch.generate(
+        sampler=lambda logits: mx.argmax(logits, axis=-1),
+        stop_criteria=lambda _: False,
+        compute_logprobs=False,
+    )
+    generated = {0: [], 1: []}
+    while len(gen):
+        for response in gen.next():
+            generated[response.uid].append(int(response.token))
+    assert all(len(v) == steps for v in generated.values())
+
+    for uid, row in enumerate(rows):
+        ids = mx.array([row])
+        cache = model.make_cache()
+        logits = run(model, ids, cache, 157)
+        want = []
+        y = mx.argmax(logits[:, -1], axis=-1)
+        for _ in range(steps):
+            want.append(int(y.item()))
+            y = mx.argmax(model(y[:, None], cache=cache).logits[:, -1], axis=-1)
+        assert generated[uid] == want, uid
+
+
+# --------------------------------------------------------------- kernel counts
+
+
+def _unfused_sconv(conv, x, state, residual):
+    """The pure-MLX path, with the same cache contents, for reference."""
+    cache = [None] * 4
+    cache[conv.conv_idx] = state
+    conv_cpu = lang.InklingShortConvolution(x.shape[-1], 4, conv.conv_idx)
+    conv_cpu.conv.weight = conv.conv.weight
+    with mx.stream(mx.cpu):
+        out = conv_cpu(x, cache=cache, residual=residual)
+        mx.eval(out, cache[conv.conv_idx])
+    return out, cache[conv.conv_idx]
+
+
+@pytest.mark.parametrize("dtype", [mx.float32, mx.bfloat16])
+@pytest.mark.parametrize("L", [1, 5, 8])
+@pytest.mark.parametrize("with_residual", [False, True])
+def test_sconv_kernel_reads_strided_inputs_exactly(dtype, L, with_residual):
+    if not (mx.default_device() == mx.gpu and mx.metal.is_available()):
+        pytest.skip("Metal kernel path")
+    B, C, width = 2, 24, 70
+    mx.random.seed(5)
+    conv = lang.InklingShortConvolution(C, 4, conv_idx=1)
+    # Checkpoint layout: [C, 1, K] transposed to [C, K, 1] (a strided view).
+    conv.conv.weight = mx.random.normal((C, 1, 4)).transpose(0, 2, 1).astype(dtype)
+    fused = mx.random.normal((B, L, width)).astype(dtype)
+    x = fused[..., 30 : 30 + C]  # a column slice, like the k/v streams
+    residual = mx.random.normal((B, L, C)).astype(dtype) if with_residual else None
+    # A state that is itself a strided slice (what the prefill path stores).
+    state = mx.concatenate([mx.random.normal((B, 3, C)), mx.zeros((B, 2, C))], axis=1)[
+        :, :3
+    ]
+    mx.eval(conv.conv.weight, fused, state)
+
+    cache = [None] * 4
+    cache[1] = state
+    out = conv(x, cache=cache, residual=residual)
+    mx.eval(out, cache[1])
+    assert out.dtype == dtype and cache[1].dtype == mx.float32
+
+    contiguous_cache = [None] * 4
+    contiguous_cache[1] = mx.contiguous(state)
+    out_c = conv(mx.contiguous(x), cache=contiguous_cache, residual=residual)
+    assert mx.array_equal(out, out_c).item()
+    assert mx.array_equal(cache[1], contiguous_cache[1]).item()
+
+    # The unfused conv accumulates the four taps in another order: 1 ulp.
+    ref, ref_state = _unfused_sconv(
+        conv, mx.contiguous(x), mx.contiguous(state), residual
+    )
+    assert mx.array_equal(cache[1], ref_state).item()
+    np.testing.assert_allclose(
+        np.array(out.astype(mx.float32)),
+        np.array(ref.astype(mx.float32)),
+        rtol=1e-6 if dtype == mx.float32 else 1e-2,
+        atol=1e-6 if dtype == mx.float32 else 2e-2,
+    )
+
+
+def _attention_inputs(monkeypatch):
+    captured = []
+    real = lang.scaled_dot_product_attention
+
+    def spy(q, k, v, cache, scale, mask, **kwargs):
+        captured.append((q, mask))
+        return real(q, k, v, cache, scale, mask, **kwargs)
+
+    monkeypatch.setattr(lang, "scaled_dot_product_attention", spy)
+    return captured
+
+
+def test_log_scaling_skipped_below_the_floor(monkeypatch):
+    floor = 8
+    config = tiny_config(log_scaling_n_floor=floor, layer_types=["hybrid"] * 3)
+    mx.random.seed(2)
+    scaled = lang.InklingAttention(config, layer_idx=0)
+    scaled.rel_proj = mx.random.normal(scaled.rel_proj.shape)
+    plain = lang.InklingAttention(config, layer_idx=0)
+    plain.update(scaled.parameters())
+    plain.log_floor = None
+    x = mx.random.normal((1, 12, 32))
+    captured = _attention_inputs(monkeypatch)
+    logs = []
+    real_log = mx.log
+    monkeypatch.setattr(mx, "log", lambda *a, **k: logs.append(1) or real_log(*a, **k))
+
+    # Prefill crossing the floor: tau applies to the rows past it only.
+    cache = CacheList(KVCache(), ArraysCache(4))
+    out = scaled(x, cache=cache)
+    plain_out = plain(x, cache=CacheList(KVCache(), ArraysCache(4)))
+    (q_s, m_s), (q_p, m_p) = captured
+    assert len(logs) == 1
+    tau = 1 + 0.1 * np.log(np.maximum(np.arange(1, 13) / floor, 1.0))
+    np.testing.assert_allclose(
+        np.array(q_s), np.array(q_p) * tau[None, None, :, None], rtol=1e-6
+    )
+    finite = np.array(m_p) > -1e29
+    np.testing.assert_allclose(
+        np.where(finite, np.array(m_s), 0),
+        np.where(finite, np.array(m_p) * tau[None, None, :, None], 0),
+        rtol=1e-6,
+        atol=1e-6,
+    )
+    assert np.array_equal(np.array(m_s) > -1e29, finite)
+    close(out[:, :floor], plain_out[:, :floor])
+    assert not np.allclose(np.array(out[:, floor:]), np.array(plain_out[:, floor:]))
+
+    # Decode below the floor: no tau ops at all, same q and mask as unscaled.
+    del captured[:]
+    del logs[:]
+    cache = CacheList(KVCache(), ArraysCache(4))
+    plain_cache = CacheList(KVCache(), ArraysCache(4))
+    for step in range(floor):
+        tok = x[:, step : step + 1]
+        close(scaled(tok, cache=cache), plain(tok, cache=plain_cache))
+    assert logs == []
+    for (q_s, m_s), (q_p, m_p) in zip(captured[::2], captured[1::2]):
+        assert mx.array_equal(q_s, q_p).item() and mx.array_equal(m_s, m_p).item()
+    # The step that crosses the floor scales again.
+    scaled(x[:, floor : floor + 1], cache=cache)
+    assert len(logs) == 1
+
+
+# ------------------------------------------------------------ logits_to_keep
+
+
+def test_logits_to_keep_limits_the_head_only():
+    model = tiny_model()
+    ids = tokens(12)
+    full = model(ids, cache=model.make_cache()).logits
+    assert full.shape == (1, 12, VOCAB - 4)
+    kept = model(ids, cache=model.make_cache(), logits_to_keep=3)
+    assert kept.logits.shape == (1, 3, VOCAB - 4)
+    close(kept.logits, full[:, -3:])
+    one = model(ids, cache=model.make_cache(), logits_to_keep=1, return_hidden=True)
+    assert one.logits.shape == (1, 1, VOCAB - 4)
+    close(one.logits, full[:, -1:])
+    assert one.hidden_states[-1].shape == (1, 12, 32)
+    for keep in (None, 0, 12, 50):
+        out = model(ids, cache=model.make_cache(), logits_to_keep=keep).logits
+        assert out.shape == full.shape
+    assert (
+        model(ids, cache=model.make_cache(), skip_logits=True, logits_to_keep=1).logits
+        is None
+    )
+
