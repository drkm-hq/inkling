+# ------------------------------------------------------ quantized KV (H2)
+
+
+def test_kv_bits_quantizes_the_global_layers_only():
+    from mlx_vlm.generate.common import maybe_quantize_kv_cache
+    from mlx_vlm.models.cache import QuantizedKVCache
+
+    model = tiny_model(head_dim=32, swa_head_dim=32)
+    ids = tokens(300)
+    reference = model.make_cache()
+    want = run(model, ids, reference, 97)
+    cache = model.make_cache()
+    assert all(type(c) is lang.InklingCacheList for c in cache)
+    maybe_quantize_kv_cache(cache, 0, 32, 8)
+    kinds = [type(c.caches[0]) for c in cache]
+    assert kinds == [SlidingWindowKVCache, QuantizedKVCache, SlidingWindowKVCache]
+    assert all(type(c) is lang.InklingCacheList for c in cache)
+    got = run(model, ids, cache, 97)
+    assert cache[1].caches[0].offset == 300 and cache[1].offset == 300
+    np.testing.assert_allclose(np.array(got), np.array(want), atol=0.15, rtol=0.05)
+    y = ids[:, -1:]
+    for _ in range(20):
+        got = model(y, cache=cache).logits
+        want = model(y, cache=reference).logits
+        np.testing.assert_allclose(np.array(got), np.array(want), atol=0.15, rtol=0.05)
+        y = mx.argmax(want[:, -1], axis=-1)[:, None]
+    # Snapshot/rollback carries the quantized cache's absolute position.
+    verify = tokens(3, seed=8)
+    _, _, state = model.speculative_verify_hidden(verify, cache)
+    assert model.rollback_speculative_cache(cache, state, 0, 3) == 0
+    assert cache[1].caches[0].offset == 321
+
+    # generate_step converts after the first prefill chunk, i.e. on a
+    # non-empty cache: KVCache.to_quantized stores what mx.quantize returns
+    # (lists), while an empty cache allocates tuples. Both must decode.
+    late, fresh = model.make_cache(), model.make_cache()
+    run(model, ids, late, 97)
+    run(model, ids, fresh, 97)
+    maybe_quantize_kv_cache(late, 0, 32, 8)
+    assert isinstance(late[1].caches[0].keys, list)
+    y = ids[:, -1:]
+    for _ in range(5):
+        got = model(y, cache=late).logits
+        want = model(y, cache=fresh).logits
+        np.testing.assert_allclose(np.array(got), np.array(want), atol=0.15, rtol=0.05)
+        y = mx.argmax(want[:, -1], axis=-1)[:, None]
+
+
+def test_other_kv_quantization_schemes_fail_clearly():
+    from mlx_vlm.generate.common import maybe_quantize_kv_cache
+
+    model = tiny_model(head_dim=32, swa_head_dim=32)
+    cache = model.make_cache()
+    model(tokens(10), cache=cache)
+    maybe_quantize_kv_cache(cache, 0, 32, 3.5)  # fractional bits: TurboQuant
+    with pytest.raises(NotImplementedError, match="kv-quant-scheme uniform"):
+        model(tokens(1), cache=cache)
+    with pytest.raises(NotImplementedError):
+        _make_cache(model, left_padding=[0, 0], kv_bits=8)
+
+
+def test_split_key_value_policy_dequantizes_the_global_layers():
+    """A non-homogeneous key/value policy installs HybridQuantKVCache, which
+    returns dequantized floats; the attention takes them as a float cache."""
+    from mlx_vlm.generate.common import maybe_quantize_kv_cache
+    from mlx_vlm.turboquant import HybridQuantKVCache
+
+    model = tiny_model(head_dim=32, swa_head_dim=32)
+    ids = tokens(300)
+    reference = model.make_cache()
+    want = run(model, ids, reference, 97)
+    cache = model.make_cache()
+    maybe_quantize_kv_cache(
+        cache,
+        0,
+        32,
+        8,
+        "uniform",
+        8,
+        4,
+        kv_key_scheme="uniform",
+        kv_value_scheme="turboquant",
+    )
+    kinds = [type(c.caches[0]) for c in cache]
+    assert kinds == [SlidingWindowKVCache, HybridQuantKVCache, SlidingWindowKVCache]
+    got = run(model, ids, cache, 97)
+    np.testing.assert_allclose(np.array(got), np.array(want), atol=0.15, rtol=0.05)
+    y = ids[:, -1:]
+    for step in range(10):
+        got = model(y, cache=cache).logits
+        want = model(y, cache=reference).logits
+        np.testing.assert_allclose(np.array(got), np.array(want), atol=0.15, rtol=0.05)
+        assert cache[1].caches[0].offset == 301 + step
+        y = mx.argmax(want[:, -1], axis=-1)[:, None]
diff --git a/mlx_vlm/tests/test_load_eval_chunks.py b/mlx_vlm/tests/test_load_eval_chunks.py
new file mode 100644
index 0000000..4d87bb6
--- /dev/null
+++ b/mlx_vlm/tests/test_load_eval_chunks.py
@@ -0,0 +1,84 @@
+"""Eager loads evaluate the parameters in bounded chunks.
+
+A single ``mx.eval`` over every parameter of an 80+ GB checkpoint is one
+command buffer; on some machines it trips the Metal GPU watchdog and the load
+aborts with ``GPU Timeout``. ``eval_parameters`` bounds each eval by bytes.
+"""
+
+import mlx.core as mx
+import mlx.nn as nn
+import pytest
+from mlx.utils import tree_flatten
+
+from mlx_vlm import utils
+
+
+class _Tiny(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.a = nn.Linear(16, 16, bias=True)
+        self.b = nn.Linear(16, 8, bias=False)
+        self.scale = mx.ones((4,))
+
+
+def _spy_eval(monkeypatch):
+    calls = []
+    real_eval = mx.eval
+
+    def spy(*args):
+        calls.append(
+            [a for _, a in tree_flatten(list(args)) if isinstance(a, mx.array)]
+        )
+        return real_eval(*args)
+
+    monkeypatch.setattr(mx, "eval", spy)
+    return calls
+
+
+def _flat(params):
+    return [a for _, a in tree_flatten(params) if isinstance(a, mx.array)]
+
+
+@pytest.mark.parametrize("chunk_bytes", [1, 200, utils.EVAL_CHUNK_BYTES])
+def test_eval_parameters_covers_every_array_once(monkeypatch, chunk_bytes):
+    model = _Tiny()
+    params = _flat(model.parameters())
+    calls = _spy_eval(monkeypatch)
+    utils.eval_parameters(model.parameters(), chunk_bytes=chunk_bytes)
+    seen = [id(a) for call in calls for a in call]
+    assert sorted(seen) == sorted(id(a) for a in params)
+    assert len(seen) == len(set(seen))
+    for call in calls[:-1]:
+        # A chunk closes as soon as it reaches the byte bound.
+        assert sum(a.nbytes for a in call) >= chunk_bytes
+        assert sum(a.nbytes for a in call[:-1]) < chunk_bytes
+    if chunk_bytes == 1:
+        assert all(len(call) == 1 for call in calls)
+    if chunk_bytes == utils.EVAL_CHUNK_BYTES:
+        assert len(calls) == 1
+
+
+def test_load_model_weights_evaluates_everything(monkeypatch, tmp_path):
+    model = _Tiny()
+    weights = {
+        k: mx.random.normal(v.shape) * 2  # lazy: not evaluated until loaded
+        for k, v in tree_flatten(model.parameters())
+    }
+    monkeypatch.setattr(utils, "EVAL_CHUNK_BYTES", 100)
+    calls = _spy_eval(monkeypatch)
+    utils.load_model_weights(model, {}, dict(weights), tmp_path)
+    loaded = dict(tree_flatten(model.parameters()))
+    evaluated = {id(a) for call in calls for a in call}
+    assert {id(a) for a in loaded.values()} <= evaluated
+    assert len(calls) > 1
+    for k, v in weights.items():
+        assert mx.array_equal(loaded[k], v).item(), k
+    assert model.model_path == tmp_path
+
+
+def test_lazy_load_does_not_eval(monkeypatch, tmp_path):
+    model = _Tiny()
+    weights = dict(tree_flatten(model.parameters()))
+    calls = _spy_eval(monkeypatch)
+    utils.load_model_weights(model, {}, weights, tmp_path, lazy=True)
+    assert calls == []
diff --git a/mlx_vlm/tests/test_sliding_window_cache.py b/mlx_vlm/tests/test_sliding_window_cache.py
new file mode 100644
index 0000000..1f5f26d
--- /dev/null
+++ b/mlx_vlm/tests/test_sliding_window_cache.py
@@ -0,0 +1,281 @@
+"""SlidingWindowKVCache keeps a bounded, temporally ordered window.
+
+The reference is an unbounded ``KVCache`` fed the same tokens: after every
+update the window cache must return a suffix of the reference's keys, at
+least ``max_size - 1`` positions before the new ones, inside a bounded
+buffer. The batch form must match per-row single caches.
+"""
+
+import mlx.core as mx
+import pytest
+
+from mlx_vlm.generate import dispatch
+from mlx_vlm.models.cache import (
+    BatchKVCache,
+    BatchSlidingWindowKVCache,
+    CacheList,
+    KVCache,
+    SlidingWindowKVCache,
+)
+
+H, D = 2, 4
+
+
+def kv(positions, batch=1):
+    """Keys/values whose value encodes the absolute position (and the row)."""
+    positions = list(positions)
+    pos = mx.array(positions, dtype=mx.float32)
+    rows = mx.arange(batch, dtype=mx.float32)[:, None, None, None] * 1000
+    base = mx.broadcast_to(pos[None, None, :, None], (batch, H, len(positions), D))
+    return base + rows, base + rows + 0.5
+
+
+def positions_of(keys):
+    return keys[0, 0, :, 0].tolist()
+
+
+@pytest.mark.parametrize("buffer_size", [0, 3, 64])
+@pytest.mark.parametrize(
+    "schedule", [[1] * 40, [13, 1, 1, 7, 1, 1, 1, 1, 30, 1, 1, 1], [40, 2, 2, 1]]
+)
+def test_window_matches_reference_suffix(buffer_size, schedule):
+    window = 8
+    cache = SlidingWindowKVCache(window, buffer_size=buffer_size)
+    reference = KVCache()
+    pos = 0
+    for L in schedule:
+        k, v = kv(range(pos, pos + L))
+        ref_k, _ = reference.update_and_fetch(k, v)
+        out_k, out_v = cache.update_and_fetch(k, v)
+        pos += L
+        n = out_k.shape[2]
+        assert cache.offset == reference.offset == pos
+        assert positions_of(out_k) == positions_of(ref_k)[-n:]
+        assert mx.array_equal(out_v[..., 0], out_k[..., 0] + 0.5).item()
+        retained = n - L
+        assert retained == min(pos - L, max(window - 1, retained))
+        assert retained <= window - 1 + max(buffer_size, L)
+        assert cache.start_position == pos - n
+        assert cache._idx == n
+        assert cache.keys.shape[2] <= cache._capacity_for(window + max(buffer_size, L))
+
+
+def test_buffer_stays_bounded_over_a_long_decode():
+    cache = SlidingWindowKVCache(512, buffer_size=256)
+    k, v = kv(range(2048))
+    cache.update_and_fetch(k, v)
+    for pos in range(2048, 2048 + 3000):
+        k, v = kv([pos])
+        out_k, _ = cache.update_and_fetch(k, v)
+        assert 512 <= out_k.shape[2] <= 512 + 256
+    assert cache.keys.shape[2] <= 2560  # capacity set by the 2048-token chunk
+    assert cache.nbytes == 2 * cache.keys.nbytes
+
+
+def test_trim_rolls_back_like_the_reference():
+    cache = SlidingWindowKVCache(8, buffer_size=4)
+    reference = KVCache()
+    k, v = kv(range(20))
+    cache.update_and_fetch(k, v)
+    reference.update_and_fetch(k, v)
+    for pos in range(20, 26):
+        cache.update_and_fetch(*kv([pos]))
+        reference.update_and_fetch(*kv([pos]))
+    assert cache.is_trimmable()
+    # 20 tokens then 6 decodes: the compaction at 25 kept positions 18..,
+    # so one key of slack exists; trimming 1 keeps full coverage.
+    assert cache.start_position == 18 and cache._idx == 8
+    assert cache.trim(1) == reference.trim(1) == 1
+    assert cache.offset == reference.offset == 25
+    for pos in range(25, 33):
+        out_k, _ = cache.update_and_fetch(*kv([pos + 100]))
+        ref_k, _ = reference.update_and_fetch(*kv([pos + 100]))
+        n = out_k.shape[2]
+        assert positions_of(out_k) == positions_of(ref_k)[-n:]
+        assert n - 1 >= 7  # the query always sees its full window
+
+
+def test_trim_past_the_compaction_slack_is_refused():
+    cache = SlidingWindowKVCache(8, buffer_size=4)
+    cache.update_and_fetch(*kv(range(20)))
+    for pos in range(20, 26):
+        cache.update_and_fetch(*kv([pos]))
+    assert cache.start_position == 18 and cache._idx == 8
+    with pytest.raises(ValueError, match="rewind past the window"):
+        cache.trim(2)  # would leave the query at 24 with 6 old keys, not 7
+    assert cache.offset == 26 and cache._idx == 8  # untouched
+    out_k, _ = cache.update_and_fetch(*kv([26]))
+    assert positions_of(out_k) == [float(p) for p in range(18, 27)]
+
+    # A cache that never evicted can be trimmed to any depth (it is then a
+    # short context, like a prompt shorter than the window).
+    fresh = SlidingWindowKVCache(8, buffer_size=4)
+    fresh.update_and_fetch(*kv(range(6)))
+    assert fresh.trim(5) == 5 and fresh.offset == 1
+    out_k, _ = fresh.update_and_fetch(*kv([1]))
+    assert positions_of(out_k) == [0.0, 1.0]
+
+    batch = BatchSlidingWindowKVCache(8, [0, 0], buffer_size=4)
+    batch.update_and_fetch(*kv(range(20), batch=2))
+    for pos in range(20, 26):
+        batch.update_and_fetch(*kv([pos], batch=2))
+    assert batch.start_position == 18 and batch._idx == 8
+    assert batch.trim(1) == 1 and batch.offset.tolist() == [25, 25]
+    with pytest.raises(ValueError, match="rewind past the window"):
+        batch.trim(1)  # no slack left after the previous trim
+
+
+def test_snapshot_round_trips_through_state_and_meta_state():
+    cache = SlidingWindowKVCache(8, buffer_size=4)
+    for pos in range(0, 30, 3):
+        cache.update_and_fetch(*kv(range(pos, pos + 3)))
+    out_k, _ = cache.update_and_fetch(*kv([30]))
+
+    restored = SlidingWindowKVCache.from_state(
+        [mx.array(a) for a in cache.state], cache.meta_state
+    )
+    assert type(restored) is SlidingWindowKVCache
+    assert (restored.offset, restored._idx, restored.start_position) == (
+        cache.offset,
+        cache._idx,
+        cache.start_position,
+    )
+    again = SlidingWindowKVCache(8, buffer_size=4)
+    again.prefix_cache_restore(cache.prefix_cache_snapshot())
+    for c in (cache, restored, again):
+        step_k, _ = c.update_and_fetch(*kv([31]))
+        assert positions_of(step_k) == positions_of(out_k) + [31.0]
+        assert c.offset == 32
+
+
+def test_prefix_reuse_declines_once_the_window_evicted():
+    cache = SlidingWindowKVCache(8, buffer_size=2)
+    cache.update_and_fetch(*kv(range(6)))
+    assert dispatch._prefix_cache_trim_amount([cache], 4) == 2
+    cache.update_and_fetch(*kv(range(6, 30)))
+    assert cache.start_position == 0  # one update keeps its own slack
+    for pos in range(30, 35):
+        cache.update_and_fetch(*kv([pos]))
+    assert cache.start_position > 0
+    assert dispatch._prefix_cache_trim_amount([cache], 10) is None
+
+
+def _single_rows(batch_positions):
+    rows = []
+    for row, positions in enumerate(batch_positions):
+        single = SlidingWindowKVCache(8, buffer_size=4)
+        for chunk in positions:
+            k, v = kv(chunk)
+            single.update_and_fetch(k + row * 1000, v + row * 1000)
+        rows.append(single)
+    return rows
+
+
+def _visible(batch_cache, row):
+    keys = batch_cache.keys[row, 0, : batch_cache._idx, 0]
+    pad = max(0, int(batch_cache.left_padding[row].item()))
+    return keys[pad:].tolist()
+
+
+@pytest.mark.parametrize("buffer_size", [0, 4])
+def test_batch_rows_match_single_caches(buffer_size):
+    prompts = [list(range(11)), list(range(4))]
+    left = [0, 7]
+    batch = BatchSlidingWindowKVCache(8, left, buffer_size=buffer_size)
+    singles = [SlidingWindowKVCache(8, buffer_size=buffer_size) for _ in prompts]
+    # Left-padded prompt: pad columns carry garbage the mask must hide.
+    k, v = kv(range(11), batch=2)
+    k = mx.where(
+        mx.arange(11)[None, None, :, None] >= mx.array(left)[:, None, None, None], k, -1
+    )
+    batch.update_and_fetch(k, v)
+    for row, prompt in enumerate(prompts):
+        singles[row].update_and_fetch(*kv([p + 7 * row for p in prompt]))
+    for step in range(30):
+        pos = 11 + step
+        bk, bv = batch.update_and_fetch(*kv([pos], batch=2))
+        assert bk.shape[2] <= 8 + max(buffer_size, 1)
+        for row in range(2):
+            sk, _ = singles[row].update_and_fetch(*kv([pos]))
+            visible = _visible(batch, row)
+            n = min(len(visible), sk.shape[2])
+            assert visible[-n:] == [x + row * 1000 for x in positions_of(sk)[-n:]]
+            assert len(visible) >= min(8, singles[row].offset)
+        assert batch.offset.tolist() == [pos + 1, pos + 1 - 7]
+    assert batch.start_position > 0
+    assert batch.keys.shape[2] <= 256 + 8 + buffer_size
+
+    # extract() gives back temporally ordered single-row caches.
+    for row in range(2):
+        single = batch.extract(row)
+        assert type(single) is SlidingWindowKVCache
+        assert single.offset == batch.offset[row].item()
+        assert positions_of(single.keys[..., : single._idx, :]) == _visible(batch, row)
+        assert single.start_position == single.offset - single._idx
+
+
+def test_merge_extend_filter_and_trim():
+    # Row 0 decodes one token past a 13-token prompt, which evicts down to
+    # the window; the others never fill it.
+    rows = _single_rows([[list(range(13)), [13]], [list(range(3))], []])
+    assert rows[0].start_position == 6
+    merged = BatchSlidingWindowKVCache.merge(rows)
+    assert type(merged) is BatchSlidingWindowKVCache
+    assert merged.offset.tolist() == [14, 3, 0]
+    assert merged.left_padding.tolist() == [0, 5, 8]
+    assert merged.start_position == 6
+    assert _visible(merged, 0) == [float(p) for p in range(6, 14)]
+    assert _visible(merged, 1) == [1000.0, 1001.0, 1002.0]
+    assert rows[0].prefix_cache_merge(rows, [14, 3, 0]) is not None
+    assert rows[0].prefix_cache_merge(rows, [13, 3, 0]) is None
+    assert rows[0].prefix_cache_merge([rows[0], KVCache()], [14, 0]) is None
+
+    other = BatchSlidingWindowKVCache.merge(_single_rows([[list(range(5))]]))
+    merged.extend(other)
+    assert merged.batch_size == 4
+    assert merged.offset.tolist() == [14, 3, 0, 5]
+    assert _visible(merged, 3) == [float(p) for p in range(5)]
+    merged.filter(mx.array([0, 3]))
+    assert merged.offset.tolist() == [14, 5]
+    assert _visible(merged, 0) == [float(p) for p in range(6, 14)]
+    # Row 0 compacted to positions 6..13 (one key of slack): trim 1 only.
+    with pytest.raises(ValueError, match="rewind past the window"):
+        merged.trim(2)
+    assert merged.trim(1) == 1
+    assert merged.offset.tolist() == [13, 4]
+    k, _ = merged.update_and_fetch(*kv([99], batch=2))
+    assert _visible(merged, 0) == [float(p) for p in range(6, 13)] + [99.0]
+    assert _visible(merged, 1) == [0.0, 1.0, 2.0, 3.0, 1099.0]
+
+    with pytest.raises(ValueError):
+        merged.extend(BatchSlidingWindowKVCache(4, [0]))
+
+
+def test_right_padding_is_rolled_before_compaction():
+    batch = BatchSlidingWindowKVCache(8, [0, 0], buffer_size=0)
+    batch.prepare(lengths=[12, 9], right_padding=[0, 3])
+    k, v = kv(range(12), batch=2)
+    batch.update_and_fetch(k, v)
+    assert batch.start_position == 0  # nothing evicted while padding pends
+    batch.finalize()
+    assert batch.left_padding.tolist() == [0, 3]
+    bk, _ = batch.update_and_fetch(*kv([12], batch=2))
+    assert bk.shape[2] <= 9
+    assert _visible(batch, 0) == [float(p) for p in range(5, 13)]
+    # Row 1 (9 real tokens, rolled right by 3) keeps 7 old keys + the new one.
+    assert _visible(batch, 1) == [1000.0 + p for p in range(2, 9)] + [1012.0]
+
+
+def test_to_batch_and_cache_list_plumbing():
+    single = SlidingWindowKVCache(8, buffer_size=4)
+    batch = single.to_batch([0, 3])
+    assert isinstance(batch, BatchSlidingWindowKVCache)
+    assert isinstance(batch, BatchKVCache)
+    assert batch.max_size == 8 and batch.buffer_size == 4
+    assert SlidingWindowKVCache.merge([single, single]).batch_size == 2
+    pair = CacheList(single, KVCache())
+    single.update_and_fetch(*kv(range(20)))
+    clone = CacheList.from_state(pair.state, pair.meta_state)
+    assert isinstance(clone.caches[0], SlidingWindowKVCache)
+    assert clone.caches[0].offset == 20
+    assert isinstance(clone.caches[1], KVCache)
diff --git a/mlx_vlm/utils.py b/mlx_vlm/utils.py
index fd84120..eec8549 100644
--- a/mlx_vlm/utils.py
+++ b/mlx_vlm/utils.py
@@ -738,13 +738,41 @@ def load_model_weights(
         )
 
     if not lazy:
-        mx.eval(model.parameters())
+        eval_parameters(model.parameters())
 
     model.model_path = model_path
     model.eval()
     return model
 
 
+# Bytes of parameters evaluated per ``mx.eval`` when a model is loaded eagerly.
+# One ``mx.eval`` over a whole 80+ GB checkpoint runs as a single command
+# buffer, which can exceed the Metal GPU watchdog budget and abort the load
+# with ``GPU Timeout``; bounded chunks keep every command buffer short.
+EVAL_CHUNK_BYTES = 4 * 2**30
+
+
+def eval_parameters(parameters, chunk_bytes: Optional[int] = None) -> None:
+    """Evaluate every array in ``parameters``, at most ``chunk_bytes`` per eval.
+
+    Equivalent to ``mx.eval(parameters)`` once it returns; models smaller than
+    ``chunk_bytes`` (default ``EVAL_CHUNK_BYTES``) still take one ``mx.eval``.
+    """
+    if chunk_bytes is None:
+        chunk_bytes = EVAL_CHUNK_BYTES
+    chunk, nbytes = [], 0
+    for _, value in tree_flatten(parameters):
+        if not isinstance(value, mx.array):
+            continue
+        chunk.append(value)
+        nbytes += value.nbytes
+        if nbytes >= chunk_bytes:
+            mx.eval(chunk)
+            chunk, nbytes = [], 0
+    if chunk:
+        mx.eval(chunk)
+
+
 def _load_safetensors(path: str) -> dict:
     try:
         return mx.load(path)
