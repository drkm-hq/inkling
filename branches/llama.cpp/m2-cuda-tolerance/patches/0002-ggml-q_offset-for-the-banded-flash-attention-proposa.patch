diff --git a/ggml/include/ggml.h b/ggml/include/ggml.h
index 3dcf3622f..2ce5c7d1d 100644
--- a/ggml/include/ggml.h
+++ b/ggml/include/ggml.h
@@ -2518,8 +2518,10 @@ extern "C" {
             float                 logit_softcap);
 
     // flash attention with an additive banded relative-position bias, applied after scale, no dense bias tensor:
-    //   rel_logits: [rel_extent, n_head, n_batch, ne3]; rel_dist = q_idx + (n_kv - n_batch) - kv_idx
+    //   rel_logits: [rel_extent, n_head, n_batch, ne3]; rel_dist = q_idx + q_offset - kv_idx
     //   score += rel_logits[rel_dist, head, q_idx, batch] iff 0 <= rel_dist < rel_extent
+    //   q_offset: the kv index of the first query (n_kv - n_batch when the queries are the tail of the KV);
+    //             it anchors the band independently of the KV extent, so k, v and mask may end with masked padding
     GGML_API struct ggml_tensor * ggml_flash_attn_ext_banded(
             struct ggml_context * ctx,
             struct ggml_tensor  * q,
@@ -2528,7 +2530,8 @@ extern "C" {
             struct ggml_tensor  * mask,
             struct ggml_tensor  * rel_logits,
             float                 scale,
-            int64_t               rel_extent);
+            int64_t               rel_extent,
+            int32_t               q_offset);
 
     GGML_DEPRECATED(GGML_API void ggml_flash_attn_ext_set_prec(
             struct ggml_tensor * a,
diff --git a/ggml/src/ggml-cpu/ops.cpp b/ggml/src/ggml-cpu/ops.cpp
index 36c7850b1..7bd6f0116 100644
--- a/ggml/src/ggml-cpu/ops.cpp
+++ b/ggml/src/ggml-cpu/ops.cpp
@@ -8856,6 +8856,9 @@ static void ggml_compute_forward_flash_attn_ext_f16_one_chunk(
     const ggml_tensor * sinks = dst->src[4];
     const ggml_tensor * rel   = dst->src[5];
 
+    // banded op: the kv index of the first query, see ggml_flash_attn_ext_banded
+    const int32_t q_offset = rel ? ggml_get_op_params_i32(dst, 5) : 0;
+
     GGML_TENSOR_LOCALS(int64_t, neq, q,   ne)
     GGML_TENSOR_LOCALS(size_t,  nbq, q,   nb)
     GGML_TENSOR_LOCALS(int64_t, nek, k,   ne)
@@ -8987,8 +8990,8 @@ static void ggml_compute_forward_flash_attn_ext_f16_one_chunk(
             }
 
             if (rel) {
-                // the offset aligns a short decode Q block to the tail of K (FA4 seqlen_k - seqlen_q convention)
-                const int64_t rel_dist = iq1 + (nek1 - neq1) - ic;
+                // q_offset places the queries in the KV (its tail, n_kv - n_q, in the FA4 seqlen_k - seqlen_q convention)
+                const int64_t rel_dist = iq1 + q_offset - ic;
                 if (rel_dist >= 0 && rel_dist < rel->ne[0]) {
                     s += ggml_flash_attn_ext_banded_load(rel, iq1, iq2, iq3, rel_dist);
                 }
