+    // m0/m1 are not ALiBi slopes for the banded bias (the negative tag would otherwise blow up the exponent)
+    const float m0 = rel ? float(q_offset) : powf(2.0f, -(max_bias       ) / n_head_log2);
+    const float m1 = rel ? 1.0f           : powf(2.0f, -(max_bias / 2.0f) / n_head_log2);
 
     // TODO other tensor dimensions after removal of WMMA kernel:
     const uint3 ne01 = init_fastdiv_values(Q->ne[1]);
