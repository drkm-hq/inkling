From 4ddc6ed6d554c0f5b9ca27c2b95c841f3142cc5c Mon Sep 17 00:00:00 2001
From: Nick Alonso <nick@drkm.com>
Date: Wed, 28 Oct 2026 22:32:07 -0400
Subject: [PATCH 2/4] tests : banded flash attention cases at the Inkling-Small
 geometry

Eval: 32 q heads / 8 kv heads x 128 with the first ubatch (n_kv == n_q), the
band edge and the band start inside the KV, no mask, the SWA layers (window
mask, E = 512), a KV unaligned to the kernel block sizes, decode, a small
batch and a q8_0 KV, for both the prefill ubatch (512) and decode (1).

Perf: the banded op next to the plain op at the same geometry (the ceiling)
for 2K/8K/32K and an unaligned 8209.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 tests/test-backend-ops.cpp | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index 8f27b7132..4c918fa61 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -12392,6 +12392,19 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     test_cases.emplace_back(new test_flash_attn_ext_banded(128, 8, 1, 512, 17024, 1024, 1, GGML_TYPE_F16, GGML_TYPE_F32));
     test_cases.emplace_back(new test_flash_attn_ext_banded(128, 8, 1,   1, 17024, 1024, 1, GGML_TYPE_F16, GGML_TYPE_F32));
     test_cases.emplace_back(new test_flash_attn_ext_banded(128, 8, 1, 512, 32768, 1024, 1, GGML_TYPE_F16, GGML_TYPE_F32));
+    // Inkling-Small geometry (32 q heads / 8 kv heads x 128): the first ubatch (n_kv == n_q), the band edge and the band
+    // start inside the KV, no mask, the SWA layers (window mask, E = 512), a KV not aligned to the kernel block sizes,
+    // decode, a small batch (several queries per threadgroup in the vec kernels) and a quantized KV
+    test_cases.emplace_back(new test_flash_attn_ext_banded(128, 32, 8, 512,  512, 1024, 1, GGML_TYPE_F16,  GGML_TYPE_F32));
+    test_cases.emplace_back(new test_flash_attn_ext_banded(128, 32, 8, 512, 1536, 1024, 1, GGML_TYPE_F16,  GGML_TYPE_F32));
+    test_cases.emplace_back(new test_flash_attn_ext_banded(128, 32, 8, 512, 2048, 1024, 0, GGML_TYPE_F16,  GGML_TYPE_F32));
+    test_cases.emplace_back(new test_flash_attn_ext_banded(128, 32, 8, 512, 1024,  512, 2, GGML_TYPE_F16,  GGML_TYPE_F32));
+    test_cases.emplace_back(new test_flash_attn_ext_banded(128, 32, 8, 512, 8209, 1024, 1, GGML_TYPE_F16,  GGML_TYPE_F32));
+    test_cases.emplace_back(new test_flash_attn_ext_banded(128, 32, 8,   1, 8192, 1024, 1, GGML_TYPE_F16,  GGML_TYPE_F32));
+    test_cases.emplace_back(new test_flash_attn_ext_banded(128, 32, 8,   1, 8209, 1024, 1, GGML_TYPE_F16,  GGML_TYPE_F32));
+    test_cases.emplace_back(new test_flash_attn_ext_banded(128, 32, 8,   7, 4100, 1024, 1, GGML_TYPE_F16,  GGML_TYPE_F32));
+    test_cases.emplace_back(new test_flash_attn_ext_banded(128, 32, 8, 512, 8192, 1024, 1, GGML_TYPE_Q8_0, GGML_TYPE_F32));
+    test_cases.emplace_back(new test_flash_attn_ext_banded(128, 32, 8,   1, 8192, 1024, 1, GGML_TYPE_Q8_0, GGML_TYPE_F32));
 
     test_cases.emplace_back(new test_flash_attn_ext(256, 256, 4, {6, 1},   512, 512, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16));
     test_cases.emplace_back(new test_flash_attn_ext(256, 256, 4, {6, 1},  4096,  64, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16));
@@ -12983,6 +12996,18 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_perf() {
     test_cases.emplace_back(new test_flash_attn_ext(576, 512, 1, {16, 1}, 49152, 1, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16, {0, 1, 2, 3}, true, true,     0));
     test_cases.emplace_back(new test_flash_attn_ext(576, 512, 1, {16, 1}, 49152, 1, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16, {0, 1, 2, 3}, true, true,  2048));
 
+    // banded (relative-position bias) attention of the Inkling models at the Inkling-Small geometry
+    // (32 q heads / 8 kv heads x 128, rel extent 1024): prefill ubatch and decode, next to the plain op as the ceiling
+    for (int64_t kv : { 2048, 8192, 32768 }) {
+        test_cases.emplace_back(new test_flash_attn_ext_banded(128, 32, 8, 512, kv, 1024, 1, GGML_TYPE_F16, GGML_TYPE_F32));
+        test_cases.emplace_back(new test_flash_attn_ext_banded(128, 32, 8,   1, kv, 1024, 1, GGML_TYPE_F16, GGML_TYPE_F32));
+        test_cases.emplace_back(new test_flash_attn_ext(128, 128, 8, {4, 1}, kv, 512, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16));
+        test_cases.emplace_back(new test_flash_attn_ext(128, 128, 8, {4, 1}, kv,   1, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16));
+    }
+    // the model passes the exact n_kv = pos_max + 1, which is rarely aligned to the kernel block size
+    test_cases.emplace_back(new test_flash_attn_ext_banded(128, 32, 8, 512, 8209, 1024, 1, GGML_TYPE_F16, GGML_TYPE_F32));
+    test_cases.emplace_back(new test_flash_attn_ext(128, 128, 8, {4, 1}, 8209, 512, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16));
+
     // GLM 4.7 Flash gqa20
     test_cases.emplace_back(new test_flash_attn_ext(576, 512, 1, {20, 1}, 8192, 32, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16, {0, 1, 2, 3}, true, true));
     test_cases.emplace_back(new test_flash_attn_ext(576, 512, 1, {20, 1}, 8192, 512, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16, {0, 1, 2, 3}, true, true));
