         max_bias = -float(rel->ne[0]);
+        memcpy(&q_offset, (const int32_t *) KQV->op_params + 5, sizeof(q_offset));
+        GGML_ASSERT(q_offset >= -(1 << 24) && q_offset <= (1 << 24)); // exactly representable in float
