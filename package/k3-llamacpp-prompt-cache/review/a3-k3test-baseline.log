n_swa = 64

    @pytest.mark.parametrize("n_swa", [0, 64])
    def test_completion_cache_hybrid_memory(n_swa: int):
        global server
        server = ServerPreset.lfm2_hybrid()
        server.n_slots = 2
        server.n_batch = 64
        server.n_ubatch = 32
        server.cache_ram = 0
        server.temperature = 0.0
        if n_swa > 0:
            server.override_kv = f"lfm2.attention.sliding_window=int:{n_swa}"
        server.start()
    
        def tokenize(content):
            res = server.make_request("POST", "/tokenize", data={"content": content})
            assert res.status_code == 200
            return res.body["tokens"]
    
        # (cache_n, prompt_n, the sampled token, the top logprobs it was sampled from)
        def completion(prompt, cache_prompt, id_slot):
            res = server.make_request("POST", "/completion", data={
                "prompt": prompt,
                "id_slot": id_slot,
                "n_predict": 1,
                "n_probs": 5,
                "cache_prompt": cache_prompt,
            })
            assert res.status_code == 200
            timings = res.body["timings"]
            probs = res.body["completion_probabilities"][0]
            top = [(p["id"], p["logprob"]) for p in probs["top_logprobs"]]
            return timings["cache_n"], timings["prompt_n"], probs["id"], top
    
        # the cached requests use slot 0, the reference requests without the cache use slot 1
        def cached(prompt):
            return completion(prompt, True, 0)
    
        def reference(prompt):
            return completion(prompt, False, 1)[3]
    
        # the cached request evaluates its tokens in fewer ubatches than the reference, so the logprobs differ by rounding
        def assert_same_output(top, expected):
            assert [tid for tid, _ in top] == [tid for tid, _ in expected]
            for (_, lp), (_, lp_expected) in zip(top, expected):
                assert lp == pytest.approx(lp_expected, abs=5e-2)
    
        base = tokenize("Purple elephants quietly compose sonnets about tax law in the moonlight while seven tiny robots "
