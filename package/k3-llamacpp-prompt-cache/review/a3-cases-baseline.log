n_swa = 4

    @pytest.mark.parametrize("n_swa", [4, 8, 16])
    def test_a3_swa_smaller_than_extension(n_swa: int):
        global server
        name = f"swa_small_{n_swa}"
        server = lfm2_server(name, n_swa=n_swa)
        server.start()
        c = Client(server)
    
        B = c.tokenize(words_text(140, 12))[:100]
        E = c.tokenize(words_text(60, 13))[:40]
        ALT = c.tokenize(words_text(40, 14))[:12]
        T1 = c.tokenize("harbor")[:1]
        T2 = c.tokenize("anchor")[:1]
        assert E[20] != ALT[0]
    
        ref_BE = c.completion(B + E, False, 1)
        ref_BE1 = c.completion(B + E + T1, False, 1)
        ref_BE12 = c.completion(B + E + T1 + T2, False, 1)
        ref_RW = c.completion(B + E[:20] + ALT, False, 1)
    
        obs = []
    
        def cached(prompt):
            r = c.completion(prompt, True, 0)
            obs.append(r[0])
            return r
    
        cached(B)                                         # (0, 100): checkpoints at 64 and 96
        r = cached(B + E)                                 # (100, 40): checkpoints at 104 and 136
        assert_same(r[2], ref_BE[2], "extension longer than the window")
        r = cached(B + E)                                 # (136, 4)
        assert_same(r[2], ref_BE[2], "identical")
        r = cached(B + E + T1)                            # one-token extension: (140, 1)
        assert_same(r[2], ref_BE1[2], "+1", tol=0.25)
        r = cached(B + E + T1 + T2)                       # (141, 1)
>       assert_same(r[2], ref_BE12[2], "+1 +1", tol=0.25)

