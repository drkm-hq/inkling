+    def quantize_uniform(entry, nested=False):
+        # A restored composite can be a plain CacheList, without its model's
+        # conversion hook. Keep its window and auxiliary caches unchanged.
+        if nested and (
+            isinstance(entry, cache.RotatingKVCache)
+            or getattr(entry, "preserve_auxiliary_kv_state", False)
+        ):
+            return entry
+        # An explicit hook owns the whole entry, including below its threshold.
+        # Preserve the existing behavior of direct top-level cache hooks.
+        if hasattr(entry, "to_quantized"):
+            if entry.offset >= quantized_kv_start:
+                return entry.to_quantized(group_size=kv_group_size, bits=int(kv_bits))
+            return entry
+        if isinstance(entry, cache.CacheList):
+            entry.caches = [quantize_uniform(sub, True) for sub in entry.caches]
+        elif isinstance(entry, list):
+            for index, sub in enumerate(entry):
+                entry[index] = quantize_uniform(sub, True)
+        elif isinstance(entry, tuple):
+            return tuple(quantize_uniform(sub, True) for sub in entry)
+        return entry
+
