+@pytest.mark.parametrize("restore_path", ["apc-memory", "apc-disk", "batch-row"])
+def test_uniform_kv_quantization_after_cache_reconstruction(tmp_path, restore_path):
+    from mlx_vlm.apc import DiskBlockStore, _clone_prompt_cache_for_apc
+    from mlx_vlm.generate.common import maybe_quantize_kv_cache
+    from mlx_vlm.models.cache import QuantizedKVCache
+
+    model = tiny_model(head_dim=32, swa_head_dim=32)
+    ids = tokens(8)
+    if restore_path == "batch-row":
+        batch_cache = _make_cache(model, left_padding=[0, 0])
+        model(mx.concatenate([ids, ids], axis=0), cache=batch_cache)
+        restored = [entry.extract(0) for entry in batch_cache]
+    else:
+        cache = model.make_cache()
+        model(ids, cache=cache)
+        if restore_path == "apc-memory":
+            restored = _clone_prompt_cache_for_apc(cache)
+        else:
+            store = DiskBlockStore(tmp_path)
+            try:
+                assert store.save_exact_cache(
+                    1, ids.flatten().tolist(), 0, cache, synchronous=True
+                )
+                restored = store.load_exact_cache(1)[2]
+            finally:
+                store.close()
+    assert all(type(entry) is CacheList for entry in restored)
+    # Each real reuse path loses InklingCacheList's hook. Conversion must still
+    # wait for the threshold, then reach the global KV cache inside the pair.
+    maybe_quantize_kv_cache(restored, 10, 32, 8, "uniform")
+    assert type(restored[1][0]) is KVCache
+    model(tokens(2), cache=restored)
+    before = [(entry[0], entry[1]) for entry in restored]
+    maybe_quantize_kv_cache(restored, 10, 32, 8, "uniform")
+    assert [type(entry[0]) for entry in restored] == [
+        SlidingWindowKVCache,
+        QuantizedKVCache,
+        SlidingWindowKVCache,
+    ]
+    assert [entry[0].offset for entry in restored] == [10, 10, 10]
+    assert all(entry[1] is old[1] for entry, old in zip(restored, before))
+    assert restored[0][0] is before[0][0]
+    assert restored[2][0] is before[2][0]
+    output = model(tokens(1), cache=restored).logits
+    assert output.shape == (1, 1, VOCAB - 4)
+    assert mx.all(mx.isfinite(output)).item()
+
