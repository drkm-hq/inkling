+def test_uniform_nested_cache_conversion_preserves_explicit_hooks():
+    from mlx_vlm.generate.common import maybe_quantize_kv_cache
+    from mlx_vlm.models.cache import QuantizedKVCache, RotatingKVCache
+
+    def filled():
+        cache = KVCache()
+        values = mx.ones((1, 1, 4, 32))
+        cache.update_and_fetch(values, values)
+        return cache
+
+    class ProtectedPair(CacheList):
+        offset = 4
+
+        def to_quantized(self, **kwargs):
+            return self
+
+    explicit = ProtectedPair(filled())
+    nested = [CacheList(filled()), (filled(),), [filled()], explicit]
+    maybe_quantize_kv_cache(nested, 5, 32, 8, "uniform")
+    assert all(type(entry[0]) is KVCache for entry in nested)
+    maybe_quantize_kv_cache(nested, 4, 32, 8, "uniform")
+    assert all(type(entry[0]) is QuantizedKVCache for entry in nested[:3])
+    assert type(explicit[0]) is KVCache
+    # Direct hook behavior remains unchanged by recursive composite support.
+    rotating = RotatingKVCache(8)
+    with pytest.raises(NotImplementedError):
+        maybe_quantize_kv_cache([rotating], 0, 32, 8, "uniform")
