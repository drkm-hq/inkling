+# Match the affine q2 dot-product and bf16 rounding order of MLX's qmv_fast.
+_EXPERT_GATE_UP_SRC = """
+    uint lane = thread_position_in_threadgroup.x % 32;
+    uint simd = thread_position_in_threadgroup.x / 32;
+    uint selected = threadgroup_position_in_grid.y;
+    uint expert = inds[selected];
+    uint n = selected / K;
+    uint first = threadgroup_position_in_grid.x * (SG * ROWS) + simd * ROWS;
+    float a[ROWS] = {0};
+    float b[ROWS] = {0};
+    const device uchar *uw = (const device uchar *)upw;
+    const device uchar *gw = (const device uchar *)gatew;
+    for (uint start = 0; start < D; start += 512) {
+        float v[16];
+        float sum = 0;
+        uint xi = n * D + start + lane * 16;
+        for (uint j = 0; j < 16; j += 4) {
+            sum += float(x[xi+j]) + float(x[xi+j+1]) + float(x[xi+j+2]) + float(x[xi+j+3]);
+            v[j] = float(x[xi+j]);
+            v[j+1] = float(x[xi+j+1]) / 4.0f;
+            v[j+2] = float(x[xi+j+2]) / 16.0f;
+            v[j+3] = float(x[xi+j+3]) / 64.0f;
+        }
+        for (uint r = 0; r < ROWS; ++r) {
+            uint row = expert * I + first + r;
+            uint wi = row * (D/4) + start/4 + lane*4;
+            uint si = row * (D/G) + (start + lane*16)/G;
+            float au = 0;
+            float ag = 0;
+            for (uint j = 0; j < 4; ++j) {
+                uchar u = uw[wi+j];
+                uchar g = gw[wi+j];
+                au += v[4*j]*(u&3) + v[4*j+1]*(u&12) + v[4*j+2]*(u&48) + v[4*j+3]*(u&192);
+                ag += v[4*j]*(g&3) + v[4*j+1]*(g&12) + v[4*j+2]*(g&48) + v[4*j+3]*(g&192);
+            }
+            a[r] += float(ups[si])*au + sum*float(upb[si]);
+            b[r] += float(gates[si])*ag + sum*float(gateb[si]);
+        }
+    }
+    for (uint r = 0; r < ROWS; ++r) {
+        float uu = simd_sum(a[r]);
+        float gg = simd_sum(b[r]);
+        if (lane == 0) {
+            T u = T(uu);
+            T g = T(gg);
+            auto z = 1 / (1 + metal::precise::exp(metal::abs(g)));
+            T sigmoid = g < T(0) ? z : 1-z;
+            out[selected*I+first+r] = T(T(g*sigmoid)*u);
+        }
+    }
+"""
+
+
+def _make_expert_gate_up_kernel():
+    if not mx.metal.is_available():
+        return None
+    return mx.fast.metal_kernel(
+        name="inkling_expert_gate_up_q2",
+        input_names=["x", "upw", "ups", "upb", "gatew", "gates", "gateb", "inds"],
+        output_names=["out"],
+        source=_EXPERT_GATE_UP_SRC,
+    )
+
+
+_expert_gate_up_kernel = _make_expert_gate_up_kernel()
+
+
+def _expert_gate_up(x, experts, inds):
+    up, gate = experts.up_proj, experts.gate_proj
+    if (
+        _expert_gate_up_kernel is None
+        or mx.default_device() != mx.gpu
+        or x.shape[0] != 1
+        or x.dtype != mx.bfloat16
+        or x.shape[-1] % 512 != 0
+        or inds.shape[-1] > 8
+        or type(up) is not QuantizedSwitchLinear
+        or type(gate) is not QuantizedSwitchLinear
+    ):
+        return None
+    if any(
+        p.bits != 2
+        or p.group_size != 64
+        or p.mode != "affine"
+        or p.global_scale is not None
+        or "bias" in p
+        or p.scales.dtype != x.dtype
+        or p.biases is None
+        or p.biases.dtype != x.dtype
+        for p in (up, gate)
+    ):
+        return None
+    if up.weight.shape != gate.weight.shape or up.output_dims % 4 != 0:
+        return None
+    n, d = x.shape
+    i, k = up.output_dims, inds.shape[-1]
+    return _expert_gate_up_kernel(
+        inputs=[
+            x,
+            up.weight,
+            up.scales,
+            up.biases,
+            gate.weight,
+            gate.scales,
+            gate.biases,
+            inds,
+        ],
+        template=[
+            ("T", x.dtype),
+            ("D", d),
+            ("I", i),
+            ("K", k),
+            ("G", 64),
+            ("ROWS", 2),
+            ("SG", 2),
+        ],
+        grid=((i // 4) * 64, n * k, 1),
+        threadgroup=(64, 1, 1),
+        output_shapes=[(n, k, i)],
+        output_dtypes=[x.dtype],
+    )[0]
+
+
