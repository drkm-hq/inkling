+# Preserve the bf16 accumulation of MLX's small-column expert reduction.
+_EXPERT_COMBINE_SCONV_SRC = """
+    uint c = thread_position_in_grid.x;
+    T sum = T(0);
+    for (uint e = 0; e < E; ++e) {
+        T product = T(y[e*C+c] * T(weights[e]));
+        sum = T(product + sum);
+    }
+    T combined = T(sum);
+    float result = float(combined);
+    for (uint k = 0; k < K; ++k) {
+        float input = k == K-1 ? float(combined) : float(state[k*C+c]);
+        result += input * float(w[c*K+k]);
+    }
+    T convolved = T(result);
+    out[c] = T(float(convolved) + float(residual[c]));
+    for (uint k = 0; k < K-1; ++k) {
+        new_state[k*C+c] = k == K-2 ? combined : state[(k+1)*C+c];
+    }
+"""
+
+
+def _make_expert_combine_sconv_kernel():
+    if not mx.metal.is_available():
+        return None
+    return mx.fast.metal_kernel(
+        name="inkling_expert_combine_sconv",
+        input_names=["y", "weights", "w", "state", "residual"],
+        output_names=["out", "new_state"],
+        source=_EXPERT_COMBINE_SCONV_SRC,
+    )
+
+
+_expert_combine_sconv_kernel = _make_expert_combine_sconv_kernel()
+
+
+def _expert_combine_sconv(y, weights, conv, cache, residual):
+    _, e, c = y.shape
+    k = conv.kernel_size
+    state = cache[conv.slot]
+    if state is None:
+        state = mx.zeros((1, k - 1, c), y.dtype)
+    out, cache[conv.slot] = _expert_combine_sconv_kernel(
+        inputs=[y, weights, conv.weight, state, residual],
+        template=[("T", y.dtype), ("E", e), ("C", c), ("K", k)],
+        grid=(c, 1, 1),
+        threadgroup=(min(c, 256), 1, 1),
+        output_shapes=[(1, 1, c), (1, k - 1, c)],
+        output_dtypes=[y.dtype, y.dtype],
+    )
+    return out
