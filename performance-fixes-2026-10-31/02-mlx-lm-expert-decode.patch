+# Copyright © 2026 Apple Inc.
+
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import mlx.core as mx
+import mlx.nn as nn
+from mlx.utils import tree_flatten
+
+from mlx_lm.models import inkling_mm_model as inkling
+from mlx_lm.models.cache import ArraysCache, make_prompt_cache
+from mlx_lm.models.switch_layers import QuantizedSwitchLinear, SwitchGLU
+from tests.test_inkling import random_model
+
+
+class TestInklingGateUp(unittest.TestCase):
+    def make_model(self):
+        model, _ = random_model(
+            seed=47,
+            dtype=mx.bfloat16,
+            hidden_size=512,
+            intermediate_size=128,
+            dense_intermediate_size=128,
+        )
+        nn.quantize(model, group_size=64, bits=2)
+        mx.eval(model.parameters())
+        return model
+
+    def test_exact_fused_activation(self):
+        if not mx.metal.is_available() or mx.default_device() != mx.gpu:
+            self.skipTest("Metal is required")
+        model = self.make_model()
+        experts = model.layers[1].mlp.experts
+        x = mx.random.normal((1, 512)).astype(mx.bfloat16)
+        for selected in ([0, 3, 8, 9], [6, 0, 7, 3, 5, 1, 8, 9], [3, 3, 8, 9]):
+            inds = mx.array([selected], mx.uint32)
+            y = inkling._expert_gate_up(x, experts, inds)
+            self.assertIsNotNone(y)
+            expanded = x[:, None, None]
+            expected = experts.activation(
+                experts.up_proj(expanded, inds), experts.gate_proj(expanded, inds)
+            ).squeeze(-2)
+            self.assertTrue(mx.array_equal(y, expected).item())
+
+    def test_decode_and_serialization(self):
+        model = self.make_model()
+        names = {k for k, _ in tree_flatten(model.parameters())}
+        ids = mx.array([[1, 7, 4, 12, 2, 6, 3]])
+
+        def run():
+            cache = make_prompt_cache(model)
+            out = [model(ids[:, :3], cache=cache)]
+            out += [model(ids[:, i : i + 1], cache=cache) for i in range(3, 7)]
+            logits = mx.concatenate(out, axis=1)
+            mx.eval(logits, [c.state for c in cache])
+            return logits, tree_flatten([c.state for c in cache])
+
+        fused, fused_state = run()
+        with (
+            patch.object(inkling, "_expert_gate_up_kernel", None),
+            patch.object(inkling, "_expert_combine_sconv_kernel", None),
+        ):
+            reference, reference_state = run()
+        self.assertTrue(mx.array_equal(fused, reference).item())
+        for (name, actual), (expected_name, expected) in zip(
+            fused_state, reference_state
+        ):
+            self.assertEqual(name, expected_name)
+            if isinstance(actual, mx.array):
+                self.assertTrue(mx.array_equal(actual, expected).item(), name)
+            else:
+                self.assertEqual(actual, expected, name)
+        self.assertEqual(names, {k for k, _ in tree_flatten(model.parameters())})
+        self.assertFalse(any("gate_up" in key for key in names))
+        with tempfile.TemporaryDirectory() as directory:
+            target = Path(directory) / "model.safetensors"
+            model.save_weights(str(target))
+            loaded = self.make_model()
+            loaded.load_weights(str(target))
+            self.assertTrue(mx.array_equal(model(ids), loaded(ids)).item())
+
+    def test_exact_strided_gate_up_small_intermediate(self):
+        if not mx.metal.is_available() or mx.default_device() != mx.gpu:
+            self.skipTest("Metal is required")
+        mx.random.seed(48)
+        x = mx.random.normal((512, 2)).astype(mx.bfloat16)[:, 0][None]
+        inds = mx.array([[2, 0, 1, 1, 2, 0]], mx.uint32)[:, ::2]
+        for intermediate in (4, 12):
+            with self.subTest(intermediate=intermediate):
+                experts = SwitchGLU(512, intermediate, 3)
+                for name in ("up_proj", "gate_proj"):
+                    projection = QuantizedSwitchLinear(
+                        512, intermediate, 3, bias=False, group_size=64, bits=2
+                    )
+                    # Keep the logical tensors while making their last two
+                    # axes non-contiguous, including the packed weight rows.
+                    for key in ("weight", "scales", "biases"):
+                        value = projection[key]
+                        if key != "weight":
+                            value = value.astype(mx.bfloat16)
+                        projection[key] = mx.swapaxes(
+                            mx.contiguous(mx.swapaxes(value, -1, -2)), -1, -2
+                        )
+                    experts[name] = projection
+                actual = inkling._expert_gate_up(x, experts, inds)
+                self.assertIsNotNone(actual)
+                expanded = x[:, None, None]
+                expected = experts.activation(
+                    experts.up_proj(expanded, inds), experts.gate_proj(expanded, inds)
+                ).squeeze(-2)
+                self.assertTrue(mx.array_equal(actual, expected).item())
+
+    def test_exact_combine_short_conv_boundaries(self):
+        if not mx.metal.is_available() or mx.default_device() != mx.gpu:
+            self.skipTest("Metal is required")
+        mx.random.seed(49)
+        for channels in (1, 3, 31, 257):
+            for selected in (1, 3, 8):
+                for warm_state in (False, True):
+                    with self.subTest(
+                        channels=channels, selected=selected, warm_state=warm_state
+                    ):
+                        conv = inkling.ShortConv(channels, 4, slot=0)
+                        conv.eval()
+                        conv.weight = (0.3 * mx.random.normal((channels, 4, 1))).astype(
+                            mx.bfloat16
+                        )
+                        actual_cache, expected_cache = ArraysCache(1), ArraysCache(1)
+                        if warm_state:
+                            state = mx.random.normal((1, 3, channels, 2)).astype(
+                                mx.bfloat16
+                            )[..., 0]
+                            actual_cache[0] = expected_cache[0] = state
+                        for _ in range(3):
+                            y = mx.random.normal((1, selected, channels, 2)).astype(
+                                mx.bfloat16
+                            )[..., 0]
+                            weights = mx.random.uniform(shape=(1, selected, 2))[..., 0]
+                            residual = mx.random.normal((1, 1, channels, 2)).astype(
+                                mx.bfloat16
+                            )[..., 0]
+                            actual = inkling._expert_combine_sconv(
+                                y, weights, conv, actual_cache, residual
+                            )
+                            combined = (y * weights[..., None].astype(y.dtype)).sum(
+                                axis=-2
+                            )[:, None]
+                            expected = conv(combined, expected_cache, residual=residual)
+                            self.assertEqual(actual.dtype, expected.dtype)
+                            self.assertTrue(mx.array_equal(actual, expected).item())
+                            self.assertEqual(actual_cache[0].dtype, mx.bfloat16)
+                            self.assertTrue(
+                                mx.array_equal(
+                                    actual_cache[0], expected_cache[0]
+                                ).item()
+                            )
+
+    def test_combine_short_conv_fallbacks(self):
+        model, _ = random_model(seed=50, dtype=mx.bfloat16)
+        x = mx.random.normal((1, 1, 64)).astype(mx.bfloat16)
+        for condition in ("lengths", "padding", "nine_experts"):
+            with self.subTest(condition=condition):
+                cache = make_prompt_cache(model)[1]
+                if condition == "lengths":
+                    cache[1].prepare(lengths=[1])
+                elif condition == "padding":
+                    cache[1].left_padding = mx.array([0])
+                top_k = 7 if condition == "nine_experts" else 2
+                with (
+                    patch.object(model.layers[1].mlp, "top_k", top_k),
+                    patch.object(
+                        inkling, "_expert_combine_sconv", side_effect=AssertionError
+                    ),
+                ):
+                    mx.eval(model.layers[1](x, cache=cache))
+
+    def test_fallbacks(self):
+        model = self.make_model()
+        experts = model.layers[1].mlp.experts
+        x = mx.ones((1, 512), mx.bfloat16)
+        inds = mx.array([[0, 3, 8, 9]], mx.uint32)
+        self.assertIsNone(inkling._expert_gate_up(x.astype(mx.float32), experts, inds))
+        self.assertIsNone(
+            inkling._expert_gate_up(mx.broadcast_to(x, (2, 512)), experts, inds)
+        )
+        with patch.object(experts.up_proj, "bits", 4):
+            self.assertIsNone(inkling._expert_gate_up(x, experts, inds))
+        with patch.object(experts.gate_proj, "group_size", 32):
+            self.assertIsNone(inkling._expert_gate_up(x, experts, inds))
+        with patch.object(experts.up_proj, "mode", "mxfp4"):
+            self.assertIsNone(inkling._expert_gate_up(x, experts, inds))
+        model.train()
+        with (
+            patch.object(inkling, "_expert_gate_up", side_effect=AssertionError),
+            patch.object(inkling, "_expert_combine_sconv", side_effect=AssertionError),
+        ):
+            mx.eval(model(mx.array([[1]])))
+
+
+if __name__ == "__main__":
+    unittest.main()
