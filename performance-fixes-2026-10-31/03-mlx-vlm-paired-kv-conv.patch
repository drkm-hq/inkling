+import mlx.core as mx
+import pytest
+
+from mlx_vlm.models.inkling import language as lang
+from mlx_vlm.tests.test_inkling_fast_path import tiny_model, tokens
+
+
+def separate(kc, vc, k, v, cache, mask=None):
+    return kc(k, cache=cache, mask=mask), vc(v, cache=cache, mask=mask)
+
+
+@pytest.mark.parametrize("dtype", [mx.float32, mx.bfloat16, mx.float16])
+@pytest.mark.parametrize("channels", [24, 1024])
+@pytest.mark.parametrize("warm", [False, True])
+def test_paired_sconv_matches_separate_taps_and_states(dtype, channels, warm):
+    if not mx.metal.is_available():
+        pytest.skip("Metal required")
+    mx.random.seed(13)
+    kc = lang.InklingShortConvolution(channels, 4, 0)
+    vc = lang.InklingShortConvolution(channels, 4, 1)
+    for conv in (kc, vc):
+        conv.eval()
+        conv.conv.weight = (
+            mx.random.normal((channels, 1, 4)).transpose(0, 2, 1).astype(dtype)
+        )
+    states = [None] * 4
+    if warm:
+        # Non-contiguous states, as well as slices of a fused projection.
+        states[:2] = [
+            mx.random.normal((1, 3, channels * 2))[..., ::2] for _ in range(2)
+        ]
+    paired, reference = list(states), list(states)
+    for _ in range(12):
+        fused = mx.random.normal((1, 1, channels * 3 + 16)).astype(dtype)
+        k = fused[..., 8 : 8 + channels]
+        v = fused[..., channels + 12 : 2 * channels + 12]
+        got = lang._sconv_kv(kc, vc, k, v, paired)
+        want = separate(kc, vc, k, v, reference)
+        mx.eval(got, want, paired[:2], reference[:2])
+        for a, b in zip((*got, *paired[:2]), (*want, *reference[:2])):
+            assert mx.array_equal(a, b).item()
+        assert paired[0].dtype == paired[1].dtype == mx.float32
+        assert got[0].dtype == got[1].dtype == dtype
+
+
+@pytest.mark.parametrize(
+    "case", ["batch", "multitoken", "training", "mask", "no-cache"]
+)
+def test_paired_sconv_falls_back(case, monkeypatch):
+    channels = 24
+    B, L = (2, 1) if case == "batch" else (1, 5) if case == "multitoken" else (1, 1)
+    kc = lang.InklingShortConvolution(channels, 4, 0)
+    vc = lang.InklingShortConvolution(channels, 4, 1)
+    for conv in (kc, vc):
+        conv.eval()
+    if case == "training":
+        kc.train()
+
+    def forbidden(**kwargs):
+        raise AssertionError("paired kernel called outside its decode gate")
+
+    monkeypatch.setattr(lang, "_sconv_kv_kernel", forbidden)
+    k, v = mx.random.normal((B, L, channels)), mx.random.normal((B, L, channels))
+    states = None if case == "no-cache" else [None] * 4
+    reference = None if states is None else list(states)
+    mask = mx.ones((B, L), dtype=mx.bool_) if case == "mask" else None
+    got = lang._sconv_kv(kc, vc, k, v, states, mask)
+    want = separate(kc, vc, k, v, reference, mask)
+    assert all(mx.array_equal(a, b).item() for a, b in zip(got, want))
+
+
+@pytest.mark.parametrize("dtype", [mx.float32, mx.bfloat16])
+def test_paired_sconv_model_decode_is_bit_exact(dtype, monkeypatch):
+    model = tiny_model()
+    model.set_dtype(dtype)
+    paired_cache = model.make_cache()
+    separate_cache = model.make_cache()
+    for cache in (paired_cache, separate_cache):
+        for entry in cache:
+            if hasattr(entry[0], "buffer_size"):
+                entry[0].buffer_size = 0
+    ids = tokens(11)
+    model(ids, cache=paired_cache)
+    model(ids, cache=separate_cache)
+    paired_impl = lang._sconv_kv
+    for _ in range(30):
+        ids = tokens(1, seed=7)
+        monkeypatch.setattr(lang, "_sconv_kv", paired_impl)
+        got = model(ids, cache=paired_cache).logits
+        monkeypatch.setattr(lang, "_sconv_kv", separate)
+        want = model(ids, cache=separate_cache).logits
+        assert mx.array_equal(got, want).item()
+        for ca, cb in zip(paired_cache, separate_cache):
+            for a, b in zip(ca[1].state, cb[1].state):
+                assert mx.array_equal(a, b).item()
