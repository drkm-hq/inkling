+_SCONV_KV_SRC = r"""
+    uint c = thread_position_in_grid.x;
+    uint stream = thread_position_in_grid.y;
+    if (c >= C) return;
+    float x0, s0, s1, s2, w0, w1, w2, w3;
+    if (stream == 0) {
+        const size_t xb = (size_t)c * xk_strides[2];
+        const size_t sb = (size_t)c * sk_strides[2];
+        const size_t ss = sk_strides[1];
+        const size_t wb = (size_t)c * wk_strides[0];
+        const size_t ws = wk_strides[1];
+        x0 = (float)xk[xb];
+        s0 = sk[sb]; s1 = sk[sb + ss]; s2 = sk[sb + 2 * ss];
+        w0 = (float)wk[wb]; w1 = (float)wk[wb + ws];
+        w2 = (float)wk[wb + 2 * ws]; w3 = (float)wk[wb + 3 * ws];
+    } else {
+        const size_t xb = (size_t)c * xv_strides[2];
+        const size_t sb = (size_t)c * sv_strides[2];
+        const size_t ss = sv_strides[1];
+        const size_t wb = (size_t)c * wv_strides[0];
+        const size_t ws = wv_strides[1];
+        x0 = (float)xv[xb];
+        s0 = sv[sb]; s1 = sv[sb + ss]; s2 = sv[sb + 2 * ss];
+        w0 = (float)wv[wb]; w1 = (float)wv[wb + ws];
+        w2 = (float)wv[wb + 2 * ws]; w3 = (float)wv[wb + 3 * ws];
+    }
+    // Retain the separate kernel's tap order and intermediate output cast.
+    float acc = 0.0f;
+    acc += w0 * s0;
+    acc += w1 * s1;
+    acc += w2 * s2;
+    acc += w3 * x0;
+    T value = (T)((float)((T)acc) + x0);
+    if (stream == 0) {
+        outk[c] = value;
+        nsk[c] = s1; nsk[C + c] = s2; nsk[2 * C + c] = x0;
+    } else {
+        outv[c] = value;
+        nsv[c] = s1; nsv[C + c] = s2; nsv[2 * C + c] = x0;
+    }
+"""
+_sconv_kv_kernel = mx.fast.metal_kernel(
+    name="inkling_sconv_kv_decode",
+    input_names=["xk", "xv", "sk", "sv", "wk", "wv"],
+    output_names=["outk", "outv", "nsk", "nsv"],
+    source=_SCONV_KV_SRC,
+    ensure_row_contiguous=False,
+)
+
+
+def _sconv_kv(k_conv, v_conv, k, v, cache, mask=None):
+    """Compute the independent K/V decode streams in one Metal dispatch."""
+    if (
+        cache is not None
+        and mask is None
+        and not k_conv.training
+        and not v_conv.training
+        and k_conv.kernel_size == v_conv.kernel_size == 4
+        and k.shape == v.shape
+        and k.shape[:2] == (1, 1)
+        and k.dtype == v.dtype
+        and mx.default_device() == mx.gpu
+        and mx.metal.is_available()
+    ):
+        C = k.shape[-1]
+        sk, sv = cache[k_conv.conv_idx], cache[v_conv.conv_idx]
+        if sk is None:
+            sk = mx.zeros((1, 3, C), dtype=mx.float32)
+        if sv is None:
+            sv = mx.zeros((1, 3, C), dtype=mx.float32)
+        k, v, sk, sv = _sconv_kv_kernel(
+            inputs=[k, v, sk, sv, k_conv.conv.weight, v_conv.conv.weight],
+            template=[("T", k.dtype), ("C", C)],
+            grid=(_rup(C, 32), 2, 1),
+            threadgroup=(32, 1, 1),
+            output_shapes=[(1, 1, C), (1, 1, C), (1, 3, C), (1, 3, C)],
+            output_dtypes=[k.dtype, k.dtype, mx.float32, mx.float32],
+        )
+        cache[k_conv.conv_idx], cache[v_conv.conv_idx] = sk, sv
+        return k, v
+    return k_conv(k, cache=cache, mask=mask), v_conv(v, cache=cache, mask=mask)
+
+
