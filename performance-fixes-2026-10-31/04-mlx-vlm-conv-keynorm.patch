+import mlx.core as mx
+import mlx.nn as nn
+import pytest
+
+from mlx_vlm.models.inkling import language as lang
+from mlx_vlm.tests.test_inkling_fast_path import tiny_model, tokens
+
+
+def reference(kc, vc, norm, k, v, cache, mask=None):
+    k, v = lang._sconv_kv(kc, vc, k, v, cache, mask)
+    return norm(k.reshape(*k.shape[:2], -1, norm.weight.shape[0])).reshape(k.shape), v
+
+
+@pytest.mark.parametrize("dtype", [mx.float32, mx.bfloat16, mx.float16])
+@pytest.mark.parametrize("channels", [128, 1024])
+@pytest.mark.parametrize("warm", [False, True])
+def test_convnorm_exact_outputs_and_states(dtype, channels, warm):
+    mx.random.seed(71)
+    kc = lang.InklingShortConvolution(channels, 4, 0)
+    vc = lang.InklingShortConvolution(channels, 4, 1)
+    norm = nn.RMSNorm(128, eps=1e-6)
+    norm.weight = mx.random.normal((256,)).astype(dtype)[::2]
+    norm.eval()
+    for conv in (kc, vc):
+        conv.conv.weight = (
+            mx.random.normal((channels, 1, 4)).transpose(0, 2, 1).astype(dtype)
+        )
+        conv.eval()
+    states = [None] * 4
+    if warm:
+        states[:2] = [
+            mx.random.normal((1, 3, channels * 2))[..., ::2] for _ in range(2)
+        ]
+    fused, baseline = list(states), list(states)
+    for _ in range(12):
+        projection = mx.random.normal((1, 1, channels * 3 + 16)).astype(dtype)
+        k = projection[..., 8 : 8 + channels]
+        v = projection[..., channels + 12 : 2 * channels + 12]
+        actual = lang._sconv_kv_norm(kc, vc, norm, k, v, fused)
+        expected = reference(kc, vc, norm, k, v, baseline)
+        mx.eval(actual, expected, fused[:2], baseline[:2])
+        for a, b in zip((*actual, *fused[:2]), (*expected, *baseline[:2])):
+            assert mx.array_equal(a, b).item(), float(
+                mx.max(mx.abs(a.astype(mx.float32) - b.astype(mx.float32))).item()
+            )
+
+
+@pytest.mark.parametrize("dtype", [mx.float32, mx.bfloat16])
+def test_convnorm_model_exact_decode(dtype, monkeypatch):
+    model = tiny_model(head_dim=128, swa_head_dim=128)
+    model.set_dtype(dtype)
+    cache = model.make_cache()
+    reference_cache = model.make_cache()
+    for entries in (cache, reference_cache):
+        for entry in entries:
+            if hasattr(entry[0], "buffer_size"):
+                entry[0].buffer_size = 0
+    model(tokens(11), cache=cache)
+    model(tokens(11), cache=reference_cache)
+    impl = lang._sconv_kv_norm
+    for _ in range(30):
+        ids = tokens(1, seed=7)
+        monkeypatch.setattr(lang, "_sconv_kv_norm", impl)
+        actual = model(ids, cache=cache).logits
+        monkeypatch.setattr(lang, "_sconv_kv_norm", reference)
+        expected = model(ids, cache=reference_cache).logits
+        assert mx.array_equal(actual, expected).item()
+
+
+@pytest.mark.parametrize(
+    "case", ["batch", "multitoken", "training", "mask", "no-cache", "head-dim"]
+)
+def test_convnorm_falls_back(case, monkeypatch):
+    B, L = (2, 1) if case == "batch" else (1, 5) if case == "multitoken" else (1, 1)
+    D = 64 if case == "head-dim" else 128
+    C = 256
+    kc = lang.InklingShortConvolution(C, 4, 0)
+    vc = lang.InklingShortConvolution(C, 4, 1)
+    norm = nn.RMSNorm(D)
+    for module in (kc, vc, norm):
+        module.eval()
+    if case == "training":
+        kc.train()
+
+    def forbidden(**kwargs):
+        raise AssertionError("fused convnorm called outside its decode gate")
+
+    monkeypatch.setattr(lang, "_sconv_kvn_kernel", forbidden)
+    k, v = mx.random.normal((B, L, C)), mx.random.normal((B, L, C))
+    cache = None if case == "no-cache" else [None] * 4
+    baseline = None if cache is None else list(cache)
+    mask = mx.ones((B, L), dtype=mx.bool_) if case == "mask" else None
+    actual = lang._sconv_kv_norm(kc, vc, norm, k, v, cache, mask)
+    expected = reference(kc, vc, norm, k, v, baseline, mask)
+    assert all(mx.array_equal(a, b).item() for a, b in zip(actual, expected))
