+_SCONV_KVN_SRC = r"""
+    const uint lane = thread_index_in_simdgroup;
+    const uint row = threadgroup_position_in_grid.y;
+    const bool is_k = row < C / 128;
+    const uint head = is_k ? row : row - C / 128;
+    float values[4];
+    float norm_sum = 0.0f;
+    const uint count = is_k ? 4 : 1;
+    for (uint i = 0; i < count; ++i) {
+        const uint c = is_k ? head * 128 + lane * 4 + i : head * 32 + lane;
+        float x0, s0, s1, s2, w0, w1, w2, w3;
+        if (is_k) {
+            const size_t xb = (size_t)c * xk_strides[2];
+            const size_t sb = (size_t)c * sk_strides[2];
+            const size_t ss = sk_strides[1];
+            const size_t wb = (size_t)c * wk_strides[0];
+            const size_t ws = wk_strides[1];
+            x0 = (float)xk[xb];
+            s0 = sk[sb]; s1 = sk[sb + ss]; s2 = sk[sb + 2 * ss];
+            w0 = (float)wk[wb]; w1 = (float)wk[wb + ws];
+            w2 = (float)wk[wb + 2 * ws]; w3 = (float)wk[wb + 3 * ws];
+            nsk[c] = s1; nsk[C + c] = s2; nsk[2 * C + c] = x0;
+        } else {
+            const size_t xb = (size_t)c * xv_strides[2];
+            const size_t sb = (size_t)c * sv_strides[2];
+            const size_t ss = sv_strides[1];
+            const size_t wb = (size_t)c * wv_strides[0];
+            const size_t ws = wv_strides[1];
+            x0 = (float)xv[xb];
+            s0 = sv[sb]; s1 = sv[sb + ss]; s2 = sv[sb + 2 * ss];
+            w0 = (float)wv[wb]; w1 = (float)wv[wb + ws];
+            w2 = (float)wv[wb + 2 * ws]; w3 = (float)wv[wb + 3 * ws];
+            nsv[c] = s1; nsv[C + c] = s2; nsv[2 * C + c] = x0;
+        }
+        float acc = 0.0f;
+        acc += w0 * s0;
+        acc += w1 * s1;
+        acc += w2 * s2;
+        acc += w3 * x0;
+        T value = (T)((float)((T)acc) + x0);
+        if (is_k) {
+            values[i] = (float)value;
+            norm_sum += values[i] * values[i];
+        } else {
+            outv[c] = value;
+        }
+    }
+    if (is_k) {
+        norm_sum = simd_sum(norm_sum);
+        float inv = metal::precise::rsqrt(norm_sum / 128.0f + eps[0]);
+        for (uint i = 0; i < 4; ++i) {
+            const uint col = lane * 4 + i;
+            const uint c = head * 128 + col;
+            outk[c] = wn[col * wn_strides[0]] * (T)(values[i] * inv);
+        }
+    }
+"""
+_sconv_kvn_kernel = mx.fast.metal_kernel(
+    name="inkling_sconv_kv_norm_decode",
+    input_names=["xk", "xv", "sk", "sv", "wk", "wv", "wn", "eps"],
+    output_names=["outk", "outv", "nsk", "nsv"],
+    source=_SCONV_KVN_SRC,
+    ensure_row_contiguous=False,
+)
+
+
+@lru_cache(maxsize=8)
+def _sconv_norm_eps(eps):
+    return mx.array([eps], dtype=mx.float32)
+
+
+def _sconv_kv_norm(k_conv, v_conv, norm, k, v, cache, mask=None):
+    """Pair K/V convolution and normalize each 128-wide key head."""
+    D = norm.weight.shape[0]
+    if (
+        cache is not None
+        and mask is None
+        and not k_conv.training
+        and not v_conv.training
+        and not norm.training
+        and k_conv.kernel_size == v_conv.kernel_size == 4
+        and k.shape == v.shape
+        and k.shape[:2] == (1, 1)
+        and D == 128
+        and k.shape[-1] % 128 == 0
+        and k.dtype == v.dtype == norm.weight.dtype
+        and mx.default_device() == mx.gpu
+        and mx.metal.is_available()
+    ):
+        C = k.shape[-1]
+        sk, sv = cache[k_conv.conv_idx], cache[v_conv.conv_idx]
+        if sk is None:
+            sk = mx.zeros((1, 3, C), dtype=mx.float32)
+        if sv is None:
+            sv = mx.zeros((1, 3, C), dtype=mx.float32)
+        k, v, sk, sv = _sconv_kvn_kernel(
+            inputs=[
+                k,
+                v,
+                sk,
+                sv,
+                k_conv.conv.weight,
+                v_conv.conv.weight,
+                norm.weight,
+                _sconv_norm_eps(norm.eps),
+            ],
+            template=[("T", k.dtype), ("C", C)],
+            grid=(32, C // 128 + C // 32, 1),
+            threadgroup=(32, 1, 1),
+            output_shapes=[(1, 1, C), (1, 1, C), (1, 3, C), (1, 3, C)],
+            output_dtypes=[k.dtype, k.dtype, mx.float32, mx.float32],
+        )
+        cache[k_conv.conv_idx], cache[v_conv.conv_idx] = sk, sv
+        return k, v
+    k, v = _sconv_kv(k_conv, v_conv, k, v, cache, mask)
+    return norm(k.reshape(*k.shape[:2], -1, D)).reshape(k.shape), v
+
