+        if (strided) {
+            a = ggml_view_2d(ctx, a, rows, k, a->nb[1], ggml_type_size(type));
+        }
+        ggml_tensor * cont = tail == 3
+            ? ggml_cont_2d(ctx, ggml_transpose(ctx, a), k*2, rows/2)
+            : ggml_cont(ctx, ggml_transpose(ctx, a));
+        ggml_tensor * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, cont->ne[0], cols);
+        ggml_tensor * out = ggml_mul_mat(ctx, cont, b);
+        ggml_prec_set_acc(out, GGML_PREC_F32_PEDANTIC);
+        if (tail == 1) {
+            out = ggml_add(ctx, out, ggml_sum(ctx, cont));
+        } else if (tail == 2) {
+            ggml_set_output(cont);
+        }
+        ggml_set_name(out, "out");
         return out;
     }
