+// Small-K projection packing must stay the same across decode and prefill sizes,
+// even though the encoder only uses the fused kernel for up to 64 columns.
+static bool check_cont_mul_mat_pack() {
+    bool ok = true;
+    for (int64_t rows : { 1, 32, 65, 512 }) {
+        ggml_context * ctx = graph_ctx();
+        ggml_tensor * r = ggml_scale(ctx, ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 16, rows), scale);
+        ggml_tensor * w = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 512, 16);
+        ggml_tensor * cont = ggml_cont(ctx, ggml_transpose(ctx, w));
+        ggml_tensor * mm = ggml_mul_mat(ctx, cont, r);
+        ggml_prec_set_acc(mm, GGML_PREC_F32_PEDANTIC);
+
+        ggml_cgraph * graph = ggml_new_graph(ctx);
+        // Expand the dynamic input before the constant transpose, as Inkling does.
+        ggml_build_forward_expand(graph, r);
+        ggml_build_forward_expand(graph, mm);
+        const bool packed = ggml_metal_fusion_max(graph, node_index(graph, cont)) == 2;
+        ggml_graph_optimize(graph);
+        const bool adjacent = encoded_in_a_row(graph, { cont, mm });
+        std::printf("CONT+MUL_MAT with %lld columns: packed %d, adjacent %d: %s\n",
+            (long long) rows, packed, adjacent, packed && adjacent ? "OK" : "FAIL");
+        ok = packed && adjacent && ok;
+        ggml_free(ctx);
+    }
+    return ok;
+}
