+kernel void kernel_cont_mul_mat_f32_k16(
+        constant ggml_metal_kargs_cont_mul_mat & args,
+        device const char * a,
+        device const char * b,
+        device float * dst,
+        uint3 tg [[threadgroup_position_in_grid]],
+        uint3 tid [[thread_position_in_threadgroup]]) {
+    const int row = tg.x*128 + tid.x;
+    if (row >= args.ne0) {
+        return;
+    }
+    device const float * x = (device const float *) (b + tg.y*args.nb11);
+    float sum = 0.0f;
+    FOR_UNROLL (short k = 0; k < 16; ++k) {
+        const float w = ((device const float *) (a + k*args.nb00))[row];
+        sum = fma(w, x[k], sum);
+    }
+    dst[tg.y*args.ne0 + row] = sum;
+}
 
