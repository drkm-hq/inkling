+static bool ggml_metal_fusion_check_cont_mul_mat(
+        const ggml_metal_fusion       * fusion,
+        const ggml_tensor * const     * nodes,
+        const ggml_cgraph             * gf,
+        const int                    * node_idxs,
+              int                      idx,
+              ggml_metal_fusion_mode   mode) {
+    const ggml_tensor * cont = nodes[0];
+    const ggml_tensor * mm   = nodes[1];
+    const ggml_tensor * a    = cont->src[0];
+    const ggml_tensor * b    = mm->src[1];
+
+    if (mm->src[0] != cont || !a || !b ||
+        a->type != GGML_TYPE_F32 || b->type != GGML_TYPE_F32 ||
+        cont->type != GGML_TYPE_F32 || mm->type != GGML_TYPE_F32 ||
+        !ggml_are_same_shape(cont, a) || b->ne[0] != 16 ||
+        a->ne[0] != 16 || a->ne[1] < 32 || a->ne[1] > 2048 ||
+        a->ne[2] != 1 || a->ne[3] != 1 ||
+        a->nb[1] != sizeof(float) || a->nb[0] < a->ne[1]*sizeof(float) ||
+        b->ne[2] != 1 || b->ne[3] != 1 ||
+        !ggml_is_contiguous(b) || !ggml_is_contiguous(mm) ||
+        ggml_prec_get_acc(mm) != GGML_PREC_F32_PEDANTIC) {
+        return false;
+    }
+
+    const int output = node_idxs[idx + 1];
+    return ggml_can_fuse_subgraph_ext(gf, node_idxs + idx, 2, fusion->ops.data(), &output, 1) &&
+        // Keep packing independent of token count; limit only the compute kernel.
+        (mode != GGML_METAL_FUSION_FULL ||
+         (b->ne[1] <= 64 && !ggml_metal_fusion_overlap(mm, a) && !ggml_metal_fusion_overlap(mm, b)));
+}
